<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bajo_stock" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="5ae16d4e-a957-4dcf-b090-9458acc072ee">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>
    <style name="AlertCell" style="Cell" forecolor="#B42318" isBold="true"/>

    <parameter name="ID_SUCURSAL" class="java.lang.Integer"/>
    <parameter name="SUCURSAL" class="java.lang.String"/>
    <parameter name="ID_CATEGORIA" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="CATEGORIA" class="java.lang.String"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT p.cod_producto AS codigo,
               p.nombre AS producto,
               tp.tipo_producto AS categoria,
               inv.stock AS stock_actual,
               inv.stock_minimo AS stock_minimo,
               GREATEST(inv.stock_minimo - inv.stock, 0) AS faltante,
               COALESCE(p.precio_compra, 0) AS precio_compra,
               GREATEST(inv.stock_minimo - inv.stock, 0) * COALESCE(p.precio_compra, 0)
                   AS inversion_estimada
          FROM inventario_sucursal inv
          INNER JOIN productos p ON p.id_producto = inv.id_producto
          INNER JOIN tipos_producto tp ON tp.id_tipo_producto = p.id_tipo_producto
          INNER JOIN estados e ON e.id_estado = p.id_estado
         WHERE inv.id_sucursal = $P{ID_SUCURSAL}
           AND inv.stock_minimo IS NOT NULL
           AND inv.stock_minimo > 0
           AND inv.stock <= inv.stock_minimo
           AND UPPER(e.estado) = 'ACTIVO'
           AND ($P{ID_CATEGORIA} IS NULL OR p.id_tipo_producto = $P{ID_CATEGORIA})
         ORDER BY faltante DESC, p.nombre
    ]]></queryString>

    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="stock_actual" class="java.lang.Integer"/>
    <field name="stock_minimo" class="java.lang.Integer"/>
    <field name="faltante" class="java.lang.Integer"/>
    <field name="precio_compra" class="java.math.BigDecimal"/>
    <field name="inversion_estimada" class="java.math.BigDecimal"/>

    <variable name="CANTIDAD_PRODUCTOS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <variable name="TOTAL_FALTANTE" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{faltante}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_INVERSION" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{inversion_estimada}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="478" height="24" forecolor="#FFFFFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="18"/></textElement>
                <text><![CDATA[Productos bajo stock mínimo]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="24" width="478" height="24" forecolor="#DCEBFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{SUCURSAL} + " · Inventario actual"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="568" y="0" width="234" height="24" forecolor="#FFFFFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{CATEGORIA}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="24" width="234" height="24" forecolor="#DCEBFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Incluye productos activos cuyo stock actual es menor o igual al mínimo configurado.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText><reportElement style="Header" x="0" y="0" width="80" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="80" y="0" width="180" height="28"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="260" y="0" width="110" height="28"/><text><![CDATA[Categoría]]></text></staticText>
            <staticText><reportElement style="Header" x="370" y="0" width="65" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Stock actual]]></text></staticText>
            <staticText><reportElement style="Header" x="435" y="0" width="70" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Stock mínimo]]></text></staticText>
            <staticText><reportElement style="Header" x="505" y="0" width="70" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Faltante]]></text></staticText>
            <staticText><reportElement style="Header" x="575" y="0" width="105" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Precio compra]]></text></staticText>
            <staticText><reportElement style="Header" x="680" y="0" width="122" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Inversión estimada]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="80" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="80" y="0" width="180" height="24"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="260" y="0" width="110" height="24"/><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="AlertCell" x="370" y="0" width="65" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{stock_actual}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="435" y="0" width="70" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{stock_minimo}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="AlertCell" x="505" y="0" width="70" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{faltante}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="575" y="0" width="105" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precio_compra}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="680" y="0" width="122" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{inversion_estimada}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="52">
            <line><reportElement x="0" y="8" width="802" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="330" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[No hay productos bajo el stock mínimo para los filtros seleccionados.]]></text>
            </staticText>
            <staticText><reportElement x="365" y="16" width="65" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Productos:]]></text></staticText>
            <textField><reportElement x="430" y="16" width="40" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{CANTIDAD_PRODUCTOS} == null ? 0 : $V{CANTIDAD_PRODUCTOS}]]></textFieldExpression></textField>
            <staticText><reportElement x="485" y="16" width="95" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unidades faltantes:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="580" y="16" width="50" height="20" forecolor="#B42318"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_FALTANTE} == null ? 0 : $V{TOTAL_FALTANTE}]]></textFieldExpression></textField>
            <staticText><reportElement x="640" y="16" width="65" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Inversión:]]></text></staticText>
            <textField pattern="Q #,##0.00"><reportElement x="705" y="16" width="97" height="20" forecolor="#1769D2"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_INVERSION} == null ? java.math.BigDecimal.ZERO : $V{TOTAL_INVERSION}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
