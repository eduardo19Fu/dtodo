<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="devolucion_bodega" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail"
              columnWidth="556" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24"
              isSummaryWithPageHeaderAndFooter="true" uuid="5d2c9e7b-3a41-4c86-b0d7-8f1e6a2c4b35">

    <!-- Comprobante de devolución de tienda a bodega, versión compacta. Mismo lenguaje visual que el comprobante de
         despacho (banner azul con logo, franja de estado, tabla y firmas) con elementos propios: la ruta tienda ->
         bodega, la línea de tiempo, la barra de "% de la existencia" y las fichas de totales. Sin recuadros
         punteados: las firmas son una línea simple con su rótulo. -->

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="7.5" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" fontSize="7.5" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>
    <style name="Label" style="Base" forecolor="#66758A" fontSize="6.5" isBold="true"/>
    <style name="Value" style="Base" fontSize="8.5"/>

    <!-- Color según el estado: PENDIENTE (ámbar), REALIZADO = aprobada (verde), CANCELADO = rechazada (rojo) -->
    <style name="ColorEstado" style="Base" forecolor="#B54708"><pen lineColor="#B54708"/>
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#067647"><pen lineColor="#067647"/></style>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#B42318"><pen lineColor="#B42318"/></style>
        </conditionalStyle>
    </style>
    <style name="RellenoEstado" style="Base" mode="Opaque" forecolor="#FFFFFF" backcolor="#B54708">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#067647"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#B42318"/>
        </conditionalStyle>
    </style>
    <style name="FondoEstado" style="Base" mode="Opaque" backcolor="#FEF0C7">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#D1FADF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#FEE4E2"/>
        </conditionalStyle>
    </style>
    <!-- Color del trayecto: azul mientras espera, verde si ingresó y rojo si fue rechazada -->
    <style name="ColorRuta" style="Base" forecolor="#1769D2"><pen lineColor="#1769D2"/>
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#067647"><pen lineColor="#067647"/></style>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#B42318"><pen lineColor="#B42318"/></style>
        </conditionalStyle>
    </style>

    <parameter name="ID_DEVOLUCION" class="java.lang.Long"/>

    <parameter name="VER_COSTOS" class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression></parameter>

    <queryString language="SQL"><![CDATA[
        SELECT d.id_devolucion,
               d.fecha_registro,
               d.fecha_resolucion,
               d.estado,
               d.total,
               d.entregado_por,
               d.motivo,
               d.observaciones,
               d.motivo_cancelacion,
               s.nombre AS sucursal,
               s.direccion AS sucursal_direccion,
               b.nombre AS bodega,
               b.ubicacion AS bodega_ubicacion,
               TRIM(CONCAT(COALESCE(ur.primer_nombre, ''), ' ', COALESCE(ur.apellido, ''))) AS registrado_por,
               TRIM(CONCAT(COALESCE(uv.primer_nombre, ''), ' ', COALESCE(uv.apellido, ''))) AS resuelto_por,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               dd.cantidad,
               dd.precio_unitario,
               dd.sub_total,
               dd.existencia_sucursal
          FROM devoluciones_bodega d
          INNER JOIN sucursales s ON s.id_sucursal = d.id_sucursal_origen
          INNER JOIN bodegas b ON b.id_bodega = d.id_bodega
          INNER JOIN usuarios ur ON ur.id_usuario = d.id_usuario_registra
          LEFT JOIN usuarios uv ON uv.id_usuario = d.id_usuario_resuelve
          INNER JOIN devoluciones_bodega_detalle dd ON dd.id_devolucion = d.id_devolucion
          INNER JOIN productos p ON p.id_producto = dd.id_producto
         WHERE d.id_devolucion = $P{ID_DEVOLUCION}
         ORDER BY p.nombre, p.cod_producto
    ]]></queryString>

    <field name="id_devolucion" class="java.lang.Long"/>
    <field name="fecha_registro" class="java.sql.Timestamp"/>
    <field name="fecha_resolucion" class="java.sql.Timestamp"/>
    <field name="estado" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="entregado_por" class="java.lang.String"/>
    <field name="motivo" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="motivo_cancelacion" class="java.lang.String"/>
    <field name="sucursal" class="java.lang.String"/>
    <field name="sucursal_direccion" class="java.lang.String"/>
    <field name="bodega" class="java.lang.String"/>
    <field name="bodega_ubicacion" class="java.lang.String"/>
    <field name="registrado_por" class="java.lang.String"/>
    <field name="resuelto_por" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_unitario" class="java.math.BigDecimal"/>
    <field name="sub_total" class="java.math.BigDecimal"/>
    <field name="existencia_sucursal" class="java.lang.Integer"/>

    <variable name="CANTIDAD_LINEAS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>
    <!-- Parte de la existencia de la tienda que se devuelve en cada línea (0-100) y segmentos de la barra (0-10) -->
    <variable name="PCT_LINEA" class="java.lang.Integer" calculation="Nothing">
        <variableExpression><![CDATA[$F{existencia_sucursal} == null || $F{existencia_sucursal} <= 0 || $F{cantidad} == null ? Integer.valueOf(0)
    : Integer.valueOf((int) Math.min(100L, Math.round(100.0 * $F{cantidad} / $F{existencia_sucursal})))]]></variableExpression>
    </variable>
    <variable name="SEGMENTOS" class="java.lang.Integer" calculation="Nothing">
        <variableExpression><![CDATA[$V{PCT_LINEA} == 0 ? Integer.valueOf(0) : Integer.valueOf(Math.max(1, (int) Math.round($V{PCT_LINEA} / 10.0)))]]></variableExpression>
    </variable>

    <title>
        <band height="230">
            <!-- ===== Encabezado (44 pt) ===== -->
            <rectangle radius="7">
                <reportElement x="76" y="0" width="480" height="44" forecolor="#1769D2" backcolor="#1769D2"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="68" height="44"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <!-- Anillos entrelazados: evocan el retorno -->
            <ellipse>
                <reportElement mode="Transparent" x="352" y="11" width="22" height="22" forecolor="#5FA0EE"/>
                <graphicElement><pen lineWidth="1.4" lineColor="#5FA0EE"/></graphicElement>
            </ellipse>
            <ellipse>
                <reportElement mode="Transparent" x="363" y="11" width="22" height="22" forecolor="#8DBBF2"/>
                <graphicElement><pen lineWidth="1.4" lineColor="#8DBBF2"/></graphicElement>
            </ellipse>
            <staticText>
                <reportElement x="76" y="3" width="272" height="23" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/><paragraph leftIndent="14"/></textElement>
                <text><![CDATA[Comprobante de devolución]]></text>
            </staticText>
            <staticText>
                <reportElement x="76" y="26" width="272" height="12" forecolor="#DCEBFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/><paragraph leftIndent="14"/></textElement>
                <text><![CDATA[Retorno de existencias de tienda a bodega]]></text>
            </staticText>
            <textField>
                <reportElement x="396" y="3" width="160" height="23" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="14" isBold="true"/><paragraph rightIndent="14"/></textElement>
                <textFieldExpression><![CDATA["No. " + String.format("%06d", $F{id_devolucion})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="396" y="26" width="160" height="12" forecolor="#DCEBFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/><paragraph rightIndent="14"/></textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- ===== Franja de estado (16 pt) ===== -->
            <rectangle radius="8">
                <reportElement style="FondoEstado" x="0" y="52" width="556" height="16"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <ellipse>
                <reportElement style="RellenoEstado" x="3" y="55" width="10" height="10"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </ellipse>
            <textField>
                <reportElement style="Base" x="3" y="55" width="10" height="10" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "…" : "REALIZADO".equals($F{estado}) ? "✓" : "✗"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="ColorEstado" x="18" y="52" width="524" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado})
    ? "PENDIENTE DE APROBACIÓN · Las unidades salieron de la tienda y aún no ingresan a la bodega"
    : "REALIZADO".equals($F{estado})
        ? "DEVOLUCIÓN APROBADA · Las unidades ya forman parte del inventario de la bodega"
        : "DEVOLUCIÓN RECHAZADA · Las unidades regresaron al inventario de la tienda"]]></textFieldExpression>
            </textField>

            <!-- ===== Ruta tienda -> bodega (50 pt) ===== -->
            <rectangle radius="7">
                <reportElement mode="Opaque" x="0" y="76" width="206" height="50" forecolor="#D5DFEA" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#D5DFEA"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="1" y="81" width="3" height="40" forecolor="#53647A" backcolor="#53647A"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="12" y="82" width="188" height="9"/>
                <text><![CDATA[▣ TIENDA · ORIGEN]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="12" y="92" width="188" height="14"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{sucursal}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="12" y="108" width="188" height="11" forecolor="#66758A"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{sucursal_direccion}]]></textFieldExpression>
            </textField>

            <rectangle radius="7">
                <reportElement mode="Opaque" x="350" y="76" width="206" height="50" forecolor="#D5DFEA" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#D5DFEA"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="552" y="81" width="3" height="40" forecolor="#1769D2" backcolor="#1769D2"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="362" y="82" width="184" height="9"/>
                <text><![CDATA[▤ BODEGA · DESTINO]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="362" y="92" width="184" height="14"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{bodega}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="362" y="108" width="184" height="11" forecolor="#66758A"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{bodega_ubicacion}]]></textFieldExpression>
            </textField>

            <!-- Trayecto: discontinuo mientras espera o si se rechaza, continuo si ingresó -->
            <line>
                <reportElement style="ColorRuta" x="210" y="100" width="136" height="1">
                    <printWhenExpression><![CDATA[!"REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="2" lineStyle="Dashed"/></graphicElement>
            </line>
            <line>
                <reportElement style="ColorRuta" x="210" y="100" width="136" height="1">
                    <printWhenExpression><![CDATA["REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="2" lineStyle="Solid"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="ColorRuta" x="334" y="93" width="14" height="14">
                    <printWhenExpression><![CDATA[!"CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[▶]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColorRuta" x="208" y="93" width="14" height="14">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[◀]]></text>
            </staticText>
            <!-- Ficha con las unidades devueltas -->
            <rectangle radius="13">
                <reportElement style="ColorEstado" mode="Opaque" x="236" y="88" width="84" height="26" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.3"/></graphicElement>
            </rectangle>
            <textField evaluationTime="Report">
                <reportElement style="ColorEstado" x="236" y="90" width="84" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.format("%,d", $V{TOTAL_UNIDADES}) + ($V{TOTAL_UNIDADES} == 1 ? " unidad" : " unidades")]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Base" x="236" y="102" width="84" height="9" forecolor="#66758A"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA["en " + $V{CANTIDAD_LINEAS} + ($V{CANTIDAD_LINEAS} == 1 ? " producto" : " productos")]]></textFieldExpression>
            </textField>

            <!-- ===== Datos generales en una sola fila ===== -->
            <staticText><reportElement style="Label" x="0" y="136" width="135" height="8"/><text><![CDATA[ENTREGÓ (TIENDA)]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Value" x="0" y="145" width="135" height="12"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{entregado_por}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="139" y="136" width="135" height="8"/><text><![CDATA[REGISTRÓ]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Value" x="139" y="145" width="135" height="12"/><textFieldExpression><![CDATA[$F{registrado_por}]]></textFieldExpression></textField>
            <staticText><reportElement style="Label" x="278" y="136" width="135" height="8"/><text><![CDATA[FECHA DE REGISTRO]]></text></staticText>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement style="Value" x="278" y="145" width="135" height="12"/><textFieldExpression><![CDATA[$F{fecha_registro}]]></textFieldExpression></textField>
            <textField>
                <reportElement style="Label" x="417" y="136" width="139" height="8"/>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "RESOLUCIÓN" : "REALIZADO".equals($F{estado}) ? "APROBADA POR" : "RECHAZADA POR"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Value" x="417" y="145" width="139" height="12"/>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "Pendiente"
    : $F{resuelto_por} + ($F{fecha_resolucion} == null ? "" : " · " + new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_resolucion}))]]></textFieldExpression>
            </textField>

            <!-- Motivo y observaciones en un solo bloque -->
            <rectangle radius="5">
                <reportElement mode="Opaque" x="0" y="162" width="556" height="32" forecolor="#EEF4FC" backcolor="#EEF4FC"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="162" width="3" height="32" forecolor="#1769D2" backcolor="#1769D2"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Label" x="10" y="165" width="280" height="8"/><text><![CDATA[MOTIVO DE LA DEVOLUCIÓN]]></text></staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="10" y="174" width="284" height="19"/>
                <textElement verticalAlignment="Top"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{motivo}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="300" y="165" width="250" height="8">
                    <printWhenExpression><![CDATA[$F{observaciones} != null && !$F{observaciones}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <text><![CDATA[OBSERVACIONES]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Value" x="300" y="174" width="250" height="19">
                    <printWhenExpression><![CDATA[$F{observaciones} != null && !$F{observaciones}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Top"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>

            <!-- ===== Línea de tiempo (registrada, resolución, ingreso a la bodega) ===== -->
            <line>
                <reportElement x="30" y="208" width="496" height="1" forecolor="#C9D6E6"/>
                <graphicElement><pen lineWidth="1.5" lineColor="#C9D6E6"/></graphicElement>
            </line>
            <line>
                <reportElement x="30" y="208" width="248" height="1" forecolor="#1769D2">
                    <printWhenExpression><![CDATA["PENDIENTE".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#1769D2"/></graphicElement>
            </line>
            <line>
                <reportElement x="30" y="208" width="496" height="1" forecolor="#067647">
                    <printWhenExpression><![CDATA["REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#067647"/></graphicElement>
            </line>
            <line>
                <reportElement x="30" y="208" width="248" height="1" forecolor="#B42318">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#B42318"/></graphicElement>
            </line>
            <ellipse><reportElement mode="Opaque" x="25" y="203" width="10" height="10" forecolor="#1769D2" backcolor="#1769D2"/><graphicElement><pen lineWidth="0"/></graphicElement></ellipse>
            <ellipse><reportElement style="RellenoEstado" x="273" y="203" width="10" height="10"/><graphicElement><pen lineWidth="0"/></graphicElement></ellipse>
            <ellipse>
                <reportElement mode="Opaque" x="521" y="203" width="10" height="10" forecolor="#C9D6E6" backcolor="#FFFFFF">
                    <printWhenExpression><![CDATA["PENDIENTE".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="1.5" lineColor="#C9D6E6"/></graphicElement>
            </ellipse>
            <ellipse>
                <reportElement style="RellenoEstado" x="521" y="203" width="10" height="10">
                    <printWhenExpression><![CDATA[!"PENDIENTE".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </ellipse>

            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="0" y="216" width="130" height="9"/>
                <textElement markup="styled"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA["<style isBold='true'>REGISTRADA</style> · " + ($F{fecha_registro} == null ? "" : new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_registro}))]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="188" y="216" width="180" height="9"/>
                <textElement textAlignment="Center" markup="styled"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "<style isBold='true'>EN ESPERA</style> · <style forecolor='#66758A'>revisión del administrador</style>"
    : ("REALIZADO".equals($F{estado}) ? "<style isBold='true'>APROBADA</style>" : "<style isBold='true'>RECHAZADA</style>")
        + ($F{fecha_resolucion} == null ? "" : " · <style forecolor='#66758A'>" + new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_resolucion}) + "</style>")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="426" y="216" width="130" height="9" forecolor="#9AA7B8">
                    <printWhenExpression><![CDATA["PENDIENTE".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["INGRESO A BODEGA"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="426" y="216" width="130" height="9">
                    <printWhenExpression><![CDATA["REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["INGRESÓ A BODEGA"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="426" y="216" width="130" height="9" forecolor="#B42318">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["SIN INGRESO"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText><reportElement style="Header" x="0" y="0" width="64" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="64" y="0" width="162" height="20"/><textElement><paragraph leftIndent="6"/></textElement><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="226" y="0" width="60" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Existencia]]></text></staticText>
            <staticText><reportElement style="Header" x="286" y="0" width="46" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Cantidad]]></text></staticText>
            <staticText><reportElement style="Header" x="332" y="0" width="98" height="20"/><textElement textAlignment="Center"/><text><![CDATA[% de la existencia]]></text></staticText>
            <staticText><reportElement style="Header" x="430" y="0" width="62" height="20"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Center"/><text><![CDATA[Costo unit.]]></text></staticText>
            <staticText><reportElement style="Header" x="492" y="0" width="64" height="20"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Center"/><text><![CDATA[Subtotal]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="64" height="18"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="64" y="0" width="162" height="18"/><textElement><paragraph leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="226" y="0" width="60" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{existencia_sucursal}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="286" y="0" width="46" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <!-- Qué parte de la existencia de la tienda se devuelve: barra de diez segmentos y porcentaje -->
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="332" y="0" width="98" height="18"/><textFieldExpression><![CDATA[""]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="337" y="0" width="56" height="18"/>
                <textElement verticalAlignment="Middle" markup="styled"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA["<style forecolor='#1769D2'>" + "▰▰▰▰▰▰▰▰▰▰".substring(0, $V{SEGMENTOS}) + "</style><style forecolor='#C9D6E6'>" + "▱▱▱▱▱▱▱▱▱▱".substring(0, 10 - $V{SEGMENTOS}) + "</style>"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true"><reportElement style="Base" x="394" y="0" width="32" height="18" forecolor="#66758A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement><textFieldExpression><![CDATA[$V{PCT_LINEA} + "%"]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="430" y="0" width="62" height="18"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="492" y="0" width="64" height="18"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{sub_total}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="4" width="360" height="12" forecolor="#7B8798"/>
                <textElement><font size="6.5" isItalic="true"/></textElement>
                <text><![CDATA[Documento de control interno de inventario. No tiene validez fiscal.]]></text>
            </staticText>
            <textField>
                <reportElement x="436" y="4" width="85" height="12" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="521" y="4" width="35" height="12" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="116">
            <!-- Nota según el estado -->
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="0" y="10" width="300" height="26" forecolor="#66758A"/>
                <textElement verticalAlignment="Top"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "Unidades reservadas: no se pueden vender ni devolver de nuevo desde la tienda."
    : "REALIZADO".equals($F{estado}) ? "Registrado en el kardex de la bodega como «Ingreso por devolución»."
    : "Motivo del rechazo: " + ($F{motivo_cancelacion} == null ? "" : $F{motivo_cancelacion})]]></textFieldExpression>
            </textField>

            <!-- Fichas de totales -->
            <rectangle radius="6">
                <reportElement mode="Opaque" x="318" y="8" width="72" height="26" forecolor="#D9E3EF" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#D9E3EF"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Label" x="318" y="11" width="72" height="8"/><textElement textAlignment="Center"><font size="6"/></textElement><text><![CDATA[PRODUCTOS]]></text></staticText>
            <textField>
                <reportElement style="Base" x="318" y="19" width="72" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{CANTIDAD_LINEAS} == null ? 0 : $V{CANTIDAD_LINEAS}]]></textFieldExpression>
            </textField>
            <rectangle radius="6">
                <reportElement mode="Opaque" x="396" y="8" width="72" height="26" forecolor="#D9E3EF" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#D9E3EF"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Label" x="396" y="11" width="72" height="8"/><textElement textAlignment="Center"><font size="6"/></textElement><text><![CDATA[UNIDADES]]></text></staticText>
            <textField pattern="#,##0">
                <reportElement style="Base" x="396" y="19" width="72" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}]]></textFieldExpression>
            </textField>
            <rectangle radius="6">
                <reportElement mode="Opaque" x="474" y="8" width="82" height="26" forecolor="#1769D2" backcolor="#1769D2">
                    <printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="474" y="11" width="82" height="8" forecolor="#DCEBFF"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement>
                <textElement textAlignment="Center"><font size="6"/></textElement>
                <text><![CDATA[TOTAL AL COSTO]]></text>
            </staticText>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Base" x="476" y="19" width="78" height="13" forecolor="#FFFFFF"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
            </textField>

            <!-- Firmas: solo una línea y su rótulo, con espacio arriba para firmar y sellar -->
            <line><reportElement x="0" y="84" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <line><reportElement x="193" y="84" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <line><reportElement x="386" y="84" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <staticText><reportElement style="Label" x="0" y="88" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[ENTREGÓ · TIENDA]]></text></staticText>
            <staticText><reportElement style="Label" x="193" y="88" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[RECIBIÓ · BODEGA]]></text></staticText>
            <staticText><reportElement style="Label" x="386" y="88" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[AUTORIZÓ · ADMINISTRADOR]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Base" x="0" y="98" width="170" height="12"/><textElement textAlignment="Center"><font size="7.5"/></textElement><textFieldExpression><![CDATA[$F{entregado_por}]]></textFieldExpression></textField>
            <staticText><reportElement style="Base" x="193" y="98" width="170" height="12" forecolor="#66758A"/><textElement textAlignment="Center"><font size="7.5"/></textElement><text><![CDATA[Nombre y firma]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Base" x="386" y="98" width="170" height="12"/>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA["REALIZADO".equals($F{estado}) ? $F{resuelto_por} : ""]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Base" x="386" y="98" width="170" height="12" forecolor="#66758A">
                    <printWhenExpression><![CDATA[!"REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <text><![CDATA[Nombre, firma y sello]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
