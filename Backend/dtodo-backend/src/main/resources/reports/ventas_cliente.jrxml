<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ventas_cliente" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="968a425c-7fd2-4215-a342-ef3fc20b9911">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>

    <parameter name="ID_SUCURSAL" class="java.lang.Integer"/>
    <parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <parameter name="SUCURSAL" class="java.lang.String"/>
    <parameter name="ID_CLIENTE" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="CLIENTE" class="java.lang.String"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT c.nombre AS cliente,
               c.nit AS nit,
               c.telefono AS telefono,
               COUNT(DISTINCT f.id_factura) AS facturas,
               SUM(fd.cantidad) AS unidades,
               SUM(COALESCE(fd.sub_total, 0)) AS venta_bruta,
               SUM(COALESCE(fd.sub_total, 0) - COALESCE(fd.sub_total_descuento, fd.sub_total, 0)) AS descuento,
               SUM(COALESCE(fd.sub_total_descuento, fd.sub_total, 0)) AS venta_neta,
               MAX(f.fecha) AS ultima_compra
          FROM facturas f
          INNER JOIN clientes c ON c.id_cliente = f.id_cliente
          INNER JOIN facturas_detalle fd ON fd.id_factura = f.id_factura
         WHERE f.id_estado != 4
           AND f.id_sucursal = $P{ID_SUCURSAL}
           AND f.fecha >= $P{FECHA_INICIO}
           AND f.fecha < $P{FECHA_FIN_EXCLUSIVA}
           AND ($P{ID_CLIENTE} IS NULL OR c.id_cliente = $P{ID_CLIENTE})
         GROUP BY c.id_cliente, c.nombre, c.nit, c.telefono
         ORDER BY venta_neta DESC, c.nombre
    ]]></queryString>

    <field name="cliente" class="java.lang.String"/>
    <field name="nit" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="facturas" class="java.lang.Long"/>
    <field name="unidades" class="java.math.BigDecimal"/>
    <field name="venta_bruta" class="java.math.BigDecimal"/>
    <field name="descuento" class="java.math.BigDecimal"/>
    <field name="venta_neta" class="java.math.BigDecimal"/>
    <field name="ultima_compra" class="java.sql.Timestamp"/>

    <variable name="CANTIDAD_CLIENTES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{cliente}]]></variableExpression>
    </variable>
    <variable name="TOTAL_FACTURAS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{facturas}]]></variableExpression>
        <initialValueExpression><![CDATA[java.lang.Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{unidades}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_VENTA_NETA" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{venta_neta}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="478" height="24" forecolor="#FFFFFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="18"/></textElement>
                <text><![CDATA[Ventas por cliente]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="24" width="478" height="24" forecolor="#DCEBFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{SUCURSAL} + " · " + $P{RANGO}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="568" y="0" width="234" height="24" forecolor="#FFFFFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{CLIENTE}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="24" width="234" height="24" forecolor="#DCEBFF"
                               backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Resume documentos, unidades e importes vendidos por cliente. Los importes se expresan en quetzales.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText><reportElement style="Header" x="0" y="0" width="168" height="28"/><text><![CDATA[Cliente]]></text></staticText>
            <staticText><reportElement style="Header" x="168" y="0" width="75" height="28"/><textElement textAlignment="Center"/><text><![CDATA[NIT]]></text></staticText>
            <staticText><reportElement style="Header" x="243" y="0" width="82" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Teléfono]]></text></staticText>
            <staticText><reportElement style="Header" x="325" y="0" width="55" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Facturas]]></text></staticText>
            <staticText><reportElement style="Header" x="380" y="0" width="55" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Unidades]]></text></staticText>
            <staticText><reportElement style="Header" x="435" y="0" width="85" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Venta bruta]]></text></staticText>
            <staticText><reportElement style="Header" x="520" y="0" width="80" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Descuento]]></text></staticText>
            <staticText><reportElement style="Header" x="600" y="0" width="90" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Venta neta]]></text></staticText>
            <staticText><reportElement style="Header" x="690" y="0" width="112" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Última compra]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="168" height="24"/><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="168" y="0" width="75" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{nit}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="243" y="0" width="82" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="325" y="0" width="55" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{facturas}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="380" y="0" width="55" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{unidades}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="435" y="0" width="85" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{venta_bruta}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="520" y="0" width="80" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{descuento}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="600" y="0" width="90" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{venta_neta}]]></textFieldExpression></textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement style="Cell" x="690" y="0" width="112" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{ultima_compra}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="52">
            <line><reportElement x="0" y="8" width="802" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="325" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[No se encontraron ventas para los filtros seleccionados.]]></text>
            </staticText>
            <staticText><reportElement x="335" y="16" width="60" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Clientes:]]></text></staticText>
            <textField><reportElement x="398" y="16" width="30" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{CANTIDAD_CLIENTES} == null ? 0 : $V{CANTIDAD_CLIENTES}]]></textFieldExpression></textField>
            <staticText><reportElement x="430" y="16" width="60" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Facturas:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="493" y="16" width="40" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_FACTURAS} == null ? java.lang.Long.valueOf(0) : $V{TOTAL_FACTURAS}]]></textFieldExpression></textField>
            <staticText><reportElement x="535" y="16" width="60" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unidades:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="598" y="16" width="45" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? java.math.BigDecimal.ZERO : $V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <staticText><reportElement x="645" y="16" width="65" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Venta neta:]]></text></staticText>
            <textField pattern="Q #,##0.00"><reportElement x="712" y="16" width="90" height="20" forecolor="#1769D2"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_VENTA_NETA} == null ? java.math.BigDecimal.ZERO : $V{TOTAL_VENTA_NETA}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
