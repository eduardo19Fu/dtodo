<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="compras_periodo" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="7dc2f307-1c7b-4fbc-a408-1c4e184b445d">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>

    <parameter name="ID_SUCURSAL" class="java.lang.Integer"/>
    <parameter name="FECHA_INICIO" class="java.sql.Date"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Date"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <parameter name="SUCURSAL" class="java.lang.String"/>
    <parameter name="ID_PROVEEDOR" class="java.lang.Integer" isForPrompting="false"/>
    <parameter name="PROVEEDOR" class="java.lang.String"/>
    <parameter name="ESTADO" class="java.lang.String" isForPrompting="false"/>
    <parameter name="FILTRO_ESTADO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT LPAD(c.id_compra, 7, '0') AS numero,
               c.fecha_compra,
               c.no_comprobante,
               c.tipo_comprobante,
               p.nombre AS proveedor,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS responsable,
               c.estado,
               c.total
          FROM compras c
          INNER JOIN proveedores p ON p.id_proveedor = c.id_proveedor
          INNER JOIN usuarios u ON u.id_usuario = c.id_usuario
         WHERE c.id_sucursal = $P{ID_SUCURSAL}
           AND c.fecha_compra >= $P{FECHA_INICIO}
           AND c.fecha_compra < $P{FECHA_FIN_EXCLUSIVA}
           AND ($P{ID_PROVEEDOR} IS NULL OR c.id_proveedor = $P{ID_PROVEEDOR})
           AND ($P{ESTADO} IS NULL OR c.estado = $P{ESTADO})
         ORDER BY c.fecha_compra DESC, c.id_compra DESC
    ]]></queryString>

    <field name="numero" class="java.lang.String"/>
    <field name="fecha_compra" class="java.sql.Date"/>
    <field name="no_comprobante" class="java.lang.String"/>
    <field name="tipo_comprobante" class="java.lang.String"/>
    <field name="proveedor" class="java.lang.String"/>
    <field name="responsable" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>

    <variable name="CANTIDAD_COMPRAS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{numero}]]></variableExpression>
    </variable>
    <variable name="TOTAL_COMPRAS" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="108" y="5" width="410" height="22" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Compras por período]]></text>
            </staticText>
            <textField>
                <reportElement x="108" y="28" width="410" height="14" forecolor="#DCEBFF"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{SUCURSAL} + " · " + $P{RANGO}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="528" y="7" width="256" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{PROVEEDOR} + " · " + $P{FILTRO_ESTADO}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="25" width="216" height="13" forecolor="#DCEBFF"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Incluye las compras registradas en el período, proveedor y estado seleccionados. Los importes se expresan en quetzales.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText><reportElement style="Header" x="0" y="0" width="50" height="28"/><textElement textAlignment="Center"/><text><![CDATA[No.]]></text></staticText>
            <staticText><reportElement style="Header" x="50" y="0" width="75" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement style="Header" x="125" y="0" width="110" height="28"/><text><![CDATA[Comprobante]]></text></staticText>
            <staticText><reportElement style="Header" x="235" y="0" width="90" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Tipo]]></text></staticText>
            <staticText><reportElement style="Header" x="325" y="0" width="170" height="28"/><text><![CDATA[Proveedor]]></text></staticText>
            <staticText><reportElement style="Header" x="495" y="0" width="120" height="28"/><text><![CDATA[Registrado por]]></text></staticText>
            <staticText><reportElement style="Header" x="615" y="0" width="80" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Estado]]></text></staticText>
            <staticText><reportElement style="Header" x="695" y="0" width="97" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Total]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="50" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression></textField>
            <textField pattern="dd/MM/yyyy" isBlankWhenNull="true"><reportElement style="Cell" x="50" y="0" width="75" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{fecha_compra}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="125" y="0" width="110" height="24"/><textFieldExpression><![CDATA[$F{no_comprobante}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="235" y="0" width="90" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{tipo_comprobante}.replace('_', ' ')]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="325" y="0" width="170" height="24"/><textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="495" y="0" width="120" height="24"/><textFieldExpression><![CDATA[$F{responsable}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="615" y="0" width="80" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="695" y="0" width="97" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="52">
            <line><reportElement x="0" y="8" width="792" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="430" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[No se encontraron compras para los filtros seleccionados.]]></text>
            </staticText>
            <staticText><reportElement x="470" y="16" width="105" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Compras:]]></text></staticText>
            <textField><reportElement x="580" y="16" width="45" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{CANTIDAD_COMPRAS} == null ? 0 : $V{CANTIDAD_COMPRAS}]]></textFieldExpression></textField>
            <staticText><reportElement x="620" y="16" width="80" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Importe:]]></text></staticText>
            <textField pattern="Q #,##0.00"><reportElement x="702" y="16" width="90" height="20" forecolor="#1769D2"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_COMPRAS} == null ? java.math.BigDecimal.ZERO : $V{TOTAL_COMPRAS}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
