<?xml version="1.0" encoding="UTF-8"?>
<!-- Hoja de picking y lista de empaque de un pedido mayorista: la misma plantilla, según el parámetro DOCUMENTO
     (PICKING o EMPAQUE). Escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Sin precios ni firma de recibido. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="pedido_bodega" pageWidth="612" pageHeight="792" columnWidth="556"
              leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true"
              uuid="e1a47b60-3c2d-4f5e-9b18-6a0d2c7f4404">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box topPadding="3" bottomPadding="3" leftPadding="4" rightPadding="4"><pen lineWidth="0.35" lineColor="#9FB2C8"/></box>
    </style>

    <parameter name="ID_PROFORMA" class="java.lang.Long"/>
    <parameter name="DOCUMENTO" class="java.lang.String"><defaultValueExpression><![CDATA["PICKING"]]></defaultValueExpression></parameter>

    <queryString language="SQL"><![CDATA[
        SELECT pr.no_proforma AS no_proforma,
               DATE_FORMAT(pr.fecha_emision, '%d/%m/%Y') AS fecha,
               DATE_FORMAT(pr.fecha_entrega_estimada, '%d/%m/%Y') AS entrega,
               pr.observaciones AS observaciones,
               c.nombre AS cliente,
               c.nombre_negocio AS negocio,
               c.direccion AS direccion,
               c.contacto AS contacto,
               c.telefono_contacto AS telefono_contacto,
               COALESCE(r.nombre, '') AS ruta,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS vendedor,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               d.cantidad AS cantidad,
               d.observacion AS observacion
          FROM proformas pr
          INNER JOIN clientes c ON c.id_cliente = pr.id_cliente
          INNER JOIN usuarios u ON u.id_usuario = pr.id_usuario
          INNER JOIN proformas_detalle d ON d.id_proforma = pr.id_proforma
          INNER JOIN productos p ON p.id_producto = d.id_producto
          LEFT JOIN rutas r ON r.id_ruta = pr.id_ruta
         WHERE pr.id_proforma = $P{ID_PROFORMA}
         ORDER BY p.nombre
    ]]></queryString>

    <field name="no_proforma" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="entrega" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="negocio" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="contacto" class="java.lang.String"/>
    <field name="telefono_contacto" class="java.lang.String"/>
    <field name="ruta" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="observacion" class="java.lang.String"/>

    <variable name="TOTAL_UNIDADES" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="150">
            <rectangle radius="8">
                <reportElement x="0" y="0" width="556" height="44" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <textField>
                <reportElement x="0" y="0" width="360" height="44" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="14"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Lista de empaque" : "Hoja de picking"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="360" y="0" width="196" height="44" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/><paragraph rightIndent="14"/></textElement>
                <textFieldExpression><![CDATA["Pedido " + $F{no_proforma}]]></textFieldExpression>
            </textField>

            <staticText><reportElement x="0" y="54" width="52" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Cliente:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="52" y="54" width="300" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[($F{negocio} != null && !$F{negocio}.trim().isEmpty()) ? $F{negocio} + " (" + $F{cliente} + ")" : $F{cliente}]]></textFieldExpression></textField>
            <staticText><reportElement x="366" y="54" width="46" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Ruta:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="412" y="54" width="144" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{ruta}]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="70" width="52" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Dirección:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="52" y="70" width="300" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression></textField>
            <staticText><reportElement x="366" y="70" width="46" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Vendedor:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="412" y="70" width="144" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="86" width="52" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Encargado:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="52" y="86" width="300" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{contacto} == null ? "" : $F{contacto} + ($F{telefono_contacto} == null || $F{telefono_contacto}.isEmpty() ? "" : " · " + $F{telefono_contacto})]]></textFieldExpression></textField>
            <staticText><reportElement x="366" y="86" width="46" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Emisión:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="412" y="86" width="144" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>

            <staticText><reportElement x="366" y="102" width="46" height="13" forecolor="#53647A"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Entrega:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="412" y="102" width="144" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{entrega}]]></textFieldExpression></textField>

            <!-- La observación general es para el empaque: solo sale en esa hoja -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement mode="Opaque" backcolor="#FFF7E6" x="0" y="118" width="556" height="28">
                    <printWhenExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) && $F{observaciones} != null && !$F{observaciones}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <box topPadding="3" bottomPadding="3" leftPadding="6" rightPadding="6"><pen lineWidth="0.5" lineColor="#F0C36D"/></box>
                <textElement verticalAlignment="Middle"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Observaciones del pedido: " + $F{observaciones}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement style="Header" x="0" y="0" width="66" height="22"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="66" y="0" width="214" height="22"/><box leftPadding="4"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="280" y="0" width="46" height="22"/><textElement textAlignment="Center"/><text><![CDATA[Cant.]]></text></staticText>
            <staticText><reportElement style="Header" x="326" y="0" width="192" height="22"/><box leftPadding="4"/><text><![CDATA[Observación]]></text></staticText>
            <staticText><reportElement style="Header" x="518" y="0" width="38" height="22"/><textElement textAlignment="Center"/><text><![CDATA[Listo]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24" splitType="Stretch">
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="0" y="0" width="66" height="24"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="66" y="0" width="214" height="24"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="280" y="0" width="46" height="24"/><textElement textAlignment="Center"><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="326" y="0" width="192" height="24"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression></textField>
            <staticText><reportElement style="Cell" stretchType="RelativeToTallestObject" x="518" y="0" width="38" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="12"/></textElement><text><![CDATA[☐]]></text></staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="400" y="2" width="100" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="500" y="2" width="56" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="96">
            <line><reportElement x="0" y="8" width="556" height="1" forecolor="#B9C9DC"/></line>
            <staticText><reportElement x="0" y="16" width="200" height="22" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression></reportElement>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="6"/></textElement>
                <text><![CDATA[El pedido no tiene productos.]]></text></staticText>
            <staticText><reportElement x="330" y="16" width="130" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Total de unidades:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="460" y="16" width="96" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <textField>
                <reportElement x="0" y="58" width="260" height="14" forecolor="#53647A"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Empacó: ______________________________" : "Preparó: _____________________________"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="296" y="58" width="260" height="14" forecolor="#53647A"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Bultos: ______" : "Fecha y hora: ____________________"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
