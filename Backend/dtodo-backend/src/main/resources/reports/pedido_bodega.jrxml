<?xml version="1.0" encoding="UTF-8"?>
<!-- Hoja de picking y lista de empaque de un pedido mayorista: la misma plantilla, según el parámetro DOCUMENTO
     (PICKING o EMPAQUE). Escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Sin precios ni firma de recibido.
     Mismo lenguaje visual que la proforma: logo sin fondo, panel azul del documento, tarjeta del cliente y filas alternadas. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="pedido_bodega" pageWidth="612" pageHeight="792" columnWidth="556"
              leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true"
              uuid="e1a47b60-3c2d-4f5e-9b18-6a0d2c7f4404">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9" forecolor="#1F2A44"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2B3990" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box topPadding="4" bottomPadding="4" leftPadding="5" rightPadding="5"><bottomPen lineWidth="0.5" lineColor="#E1E7F3"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8FD"/>
        </conditionalStyle>
    </style>
    <style name="Etiqueta" style="Base" forecolor="#6B7A90" fontSize="7.5" isBold="true" vTextAlign="Middle"/>

    <parameter name="ID_PROFORMA" class="java.lang.Long"/>
    <parameter name="DOCUMENTO" class="java.lang.String"><defaultValueExpression><![CDATA["PICKING"]]></defaultValueExpression></parameter>

    <queryString language="SQL"><![CDATA[
        SELECT pr.no_proforma AS no_proforma,
               DATE_FORMAT(pr.fecha_emision, '%d/%m/%Y') AS fecha,
               DATE_FORMAT(pr.fecha_entrega_estimada, '%d/%m/%Y') AS entrega,
               pr.observaciones AS observaciones,
               c.nombre AS cliente,
               c.nombre_negocio AS negocio,
               c.direccion AS direccion,
               c.contacto AS contacto,
               c.telefono_contacto AS telefono_contacto,
               COALESCE(r.nombre, '') AS ruta,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS vendedor,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               d.cantidad AS cantidad,
               d.observacion AS observacion
          FROM proformas pr
          INNER JOIN clientes c ON c.id_cliente = pr.id_cliente
          INNER JOIN usuarios u ON u.id_usuario = pr.id_usuario
          INNER JOIN proformas_detalle d ON d.id_proforma = pr.id_proforma
          INNER JOIN productos p ON p.id_producto = d.id_producto
          LEFT JOIN rutas r ON r.id_ruta = pr.id_ruta
         WHERE pr.id_proforma = $P{ID_PROFORMA}
         ORDER BY p.nombre
    ]]></queryString>

    <field name="no_proforma" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="entrega" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="negocio" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="contacto" class="java.lang.String"/>
    <field name="telefono_contacto" class="java.lang.String"/>
    <field name="ruta" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="observacion" class="java.lang.String"/>

    <variable name="TOTAL_UNIDADES" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="196">
            <!-- Logo sin fondo y panel azul del documento -->
            <image scaleImage="RetainShape" hAlign="Left">
                <reportElement x="0" y="2" width="130" height="68"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo-proforma.png")]]></imageExpression>
            </image>
            <rectangle radius="9">
                <reportElement mode="Opaque" x="236" y="2" width="320" height="66" forecolor="#2B3990" backcolor="#2B3990"/>
            </rectangle>
            <staticText>
                <reportElement x="250" y="8" width="150" height="11" forecolor="#C3CFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <text><![CDATA[BODEGA · USO INTERNO]]></text>
            </staticText>
            <textField>
                <reportElement x="250" y="19" width="296" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="17" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Lista de empaque" : "Hoja de picking"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="46" width="296" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Pedido " + $F{no_proforma}]]></textFieldExpression>
            </textField>

            <!-- Tarjeta con los datos del cliente y del pedido -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="80" width="556" height="78" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="80" width="5" height="78" forecolor="#2B3990" backcolor="#2B3990"/>
            </rectangle>

            <staticText><reportElement style="Etiqueta" x="14" y="86" width="56" height="14"/><text><![CDATA[Cliente:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="72" y="86" width="290" height="14"/><textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement><textFieldExpression><![CDATA[($F{negocio} != null && !$F{negocio}.trim().isEmpty()) ? $F{negocio} + " (" + $F{cliente} + ")" : $F{cliente}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="14" y="104" width="56" height="14"/><text><![CDATA[Dirección:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="72" y="104" width="290" height="14"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[($F{direccion} == null || $F{direccion}.trim().isEmpty()) ? "—" : $F{direccion}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="14" y="122" width="56" height="14"/><text><![CDATA[Encargado:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="72" y="122" width="290" height="14"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[($F{contacto} == null || $F{contacto}.trim().isEmpty()) ? "—" : $F{contacto} + ($F{telefono_contacto} == null || $F{telefono_contacto}.isEmpty() ? "" : " · " + $F{telefono_contacto})]]></textFieldExpression></textField>

            <staticText><reportElement style="Etiqueta" x="376" y="86" width="48" height="14"/><text><![CDATA[Ruta:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="426" y="86" width="124" height="14"/><textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement><textFieldExpression><![CDATA[($F{ruta} == null || $F{ruta}.trim().isEmpty()) ? "—" : $F{ruta}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="376" y="104" width="48" height="14"/><text><![CDATA[Vendedor:]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="426" y="104" width="124" height="14"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="376" y="122" width="48" height="14"/><text><![CDATA[Emisión:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="426" y="122" width="124" height="14"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <staticText><reportElement style="Etiqueta" x="376" y="140" width="48" height="14"/><text><![CDATA[Entrega:]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="426" y="140" width="124" height="14"/><textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement><textFieldExpression><![CDATA[($F{entrega} == null || $F{entrega}.trim().isEmpty()) ? "Sin fecha" : $F{entrega}]]></textFieldExpression></textField>

            <!-- La observación general es para el empaque: solo sale en esa hoja -->
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement mode="Opaque" backcolor="#FFF8E5" x="0" y="164" width="556" height="24">
                    <printWhenExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) && $F{observaciones} != null && !$F{observaciones}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <box topPadding="3" bottomPadding="3" leftPadding="8" rightPadding="8"><pen lineWidth="0.75" lineColor="#F0D9A0"/></box>
                <textElement verticalAlignment="Middle"><font size="8.5"/></textElement>
                <textFieldExpression><![CDATA["Observaciones del pedido: " + $F{observaciones}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <rectangle radius="6">
                <reportElement mode="Opaque" x="0" y="0" width="556" height="24" forecolor="#2B3990" backcolor="#2B3990"/>
            </rectangle>
            <staticText><reportElement x="0" y="0" width="66" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement x="66" y="0" width="214" height="24" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="5"/></textElement><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement x="280" y="0" width="46" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Cant.]]></text></staticText>
            <staticText><reportElement x="326" y="0" width="192" height="24" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/><paragraph leftIndent="5"/></textElement><text><![CDATA[Observación]]></text></staticText>
            <staticText><reportElement x="518" y="0" width="38" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Listo]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26" splitType="Stretch">
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="0" y="0" width="66" height="26"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="66" y="0" width="214" height="26"/><textElement><font size="8.5"/></textElement><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="280" y="0" width="46" height="26"/><textElement textAlignment="Center"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="326" y="0" width="192" height="26"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression></textField>
            <staticText><reportElement style="Cell" stretchType="RelativeToTallestObject" x="518" y="0" width="38" height="26"/><text><![CDATA[]]></text></staticText>
            <!-- casilla para marcar lo ya preparado -->
            <rectangle radius="3">
                <reportElement mode="Opaque" x="530" y="6" width="14" height="14" forecolor="#8C9BB5" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1" lineColor="#8C9BB5"/></graphicElement>
            </rectangle>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="2" width="556" height="1" forecolor="#E1E7F3"/></line>
            <textField>
                <reportElement x="400" y="5" width="100" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="500" y="5" width="56" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="5" width="300" height="14" forecolor="#7B8798"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Lista de empaque · D'Todo" : "Hoja de picking · D'Todo"]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="110">
            <staticText><reportElement x="0" y="10" width="260" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression></reportElement>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[El pedido no tiene productos.]]></text></staticText>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="336" y="10" width="220" height="38" forecolor="#2B3990" backcolor="#2B3990"/>
            </rectangle>
            <staticText><reportElement x="348" y="10" width="124" height="38" forecolor="#C3CFFF"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Total de unidades:]]></text></staticText>
            <textField pattern="#,##0">
                <reportElement x="472" y="10" width="72" height="38" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="86" width="250" height="1" forecolor="#8C9BB5"/></line>
            <line><reportElement x="306" y="86" width="250" height="1" forecolor="#8C9BB5"/></line>
            <textField>
                <reportElement x="0" y="89" width="250" height="14" forecolor="#6B7A90"/>
                <textElement><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Empacó:" : "Preparó:"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="306" y="89" width="250" height="14" forecolor="#6B7A90"/>
                <textElement><font size="8.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["EMPAQUE".equals($P{DOCUMENTO}) ? "Bultos:" : "Fecha y hora:"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
