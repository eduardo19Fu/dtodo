<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_despacho" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="b4c3d215-7e21-4a2f-9d5a-8b37d40a1f01">
	<parameter name="idEvento" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT d.id_evento,
			MIN(d.id_despacho) AS numero_despacho,
			d.fecha_despacho,
			LPAD(nc.id_nota_credito, 7, '0') AS id_nota_credito,
			nc.correlativo_factura_sat,
			nc.serie_factura_sat,
			nc.total AS total_nota,
			nc.estado AS estado_nota,
			cl.nombre AS cliente,
			cl.nit,
			cl.direccion,
			CONCAT(us.primer_nombre, ' ', us.apellido) AS usuario_despacho,
			us.usuario AS usuario_login,
			p.cod_producto AS codigo,
			p.nombre AS nombre_producto,
			d.cantidad,
			d.total_despacho
FROM despachos_nota AS d
INNER JOIN notas_credito AS nc ON nc.id_nota_credito = d.id_nota_credito
INNER JOIN clientes AS cl ON cl.id_cliente = nc.id_cliente
INNER JOIN usuarios AS us ON us.id_usuario = d.id_usuario
INNER JOIN productos AS p ON p.id_producto = d.id_producto
WHERE d.id_evento = $P{idEvento}
GROUP BY d.id_despacho, d.id_evento, d.fecha_despacho, nc.id_nota_credito, nc.correlativo_factura_sat,
	nc.serie_factura_sat, nc.total, nc.estado, cl.nombre, cl.nit, cl.direccion,
	us.primer_nombre, us.apellido, us.usuario, p.cod_producto, p.nombre, d.cantidad, d.total_despacho
ORDER BY p.nombre]]>
	</queryString>
