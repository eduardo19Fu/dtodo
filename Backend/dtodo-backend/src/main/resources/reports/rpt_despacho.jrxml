	<field name="correlativo_factura_sat" class="java.lang.String"/>
	<field name="serie_factura_sat" class="java.lang.String"/>
	<field name="total_nota" class="java.math.BigDecimal"/>
	<field name="estado_nota" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="nit" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="usuario_despacho" class="java.lang.String"/>
