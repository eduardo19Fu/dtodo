	<field name="codigo" class="java.lang.String"/>
	<field name="nombre_producto" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="total_despacho" class="java.math.BigDecimal"/>
	<variable name="totalGeneral" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_despacho}]]></variableExpression>
	</variable>
	<variable name="totalUnidades" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
	</variable>
