                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "2 · EN ESPERA · revisión del administrador"
    : ("REALIZADO".equals($F{estado}) ? "2 · APROBADO" : "2 · CANCELADO")
        + ($F{fecha_resolucion} == null ? "" : " · " + new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_resolucion}))]]></textFieldExpression>
            </textField>
            <rectangle radius="4">
                <reportElement style="PasoIngreso" x="374" y="151" width="182" height="19"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement style="PasoIngreso" mode="Transparent" x="374" y="151" width="182" height="19"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "3 · INGRESO AL DESTINO"
    : "REALIZADO".equals($F{estado}) ? "3 · INGRESÓ AL DESTINO" : "3 · REGRESÓ A LA BODEGA"]]></textFieldExpression>
            </textField>
            <staticText><reportElement style="Base" x="175" y="153" width="14" height="14" forecolor="#E0A526"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><text><![CDATA[▶]]></text></staticText>
            <staticText><reportElement style="Base" x="362" y="153" width="14" height="14" forecolor="#E0A526"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><text><![CDATA[▶]]></text></staticText>

            <!-- ===== Ficha de datos, celdas de formulario ===== -->
            <staticText><reportElement style="CeldaEtiqueta" x="0" y="178" width="139" height="11"/><text><![CDATA[DESPACHÓ]]></text></staticText>
            <staticText><reportElement style="CeldaEtiqueta" x="139" y="178" width="139" height="11"/><text><![CDATA[RECIBE EN DESTINO]]></text></staticText>
            <staticText><reportElement style="CeldaEtiqueta" x="278" y="178" width="139" height="11"/><text><![CDATA[FECHA DE REGISTRO]]></text></staticText>
            <textField>
                <reportElement style="CeldaEtiqueta" x="417" y="178" width="139" height="11"/>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "RESOLUCIÓN" : "REALIZADO".equals($F{estado}) ? "APROBADO POR" : "CANCELADO POR"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="CeldaValor" x="0" y="189" width="139" height="19"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{despachado_por}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="CeldaValor" x="139" y="189" width="139" height="19"/><textFieldExpression><![CDATA[$F{recibido_por}]]></textFieldExpression></textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement style="CeldaValor" x="278" y="189" width="139" height="19"/><textFieldExpression><![CDATA[$F{fecha_registro}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="CeldaValor" x="417" y="189" width="139" height="19"/>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "Pendiente"
    : $F{resuelto_por} + ($F{fecha_resolucion} == null ? "" : " · " + new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_resolucion}))]]></textFieldExpression>
            </textField>

            <staticText><reportElement style="CeldaEtiqueta" x="0" y="208" width="556" height="11"/><text><![CDATA[OBSERVACIONES]]></text></staticText>
            <staticText>
                <reportElement style="CeldaEtiqueta" mode="Transparent" forecolor="#B42318" x="300" y="208" width="250" height="11">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0"/></box>
                <text><![CDATA[MOTIVO DE LA CANCELACIÓN]]></text>
            </staticText>
            <staticText><reportElement style="CeldaValor" x="0" y="219" width="556" height="19"/><text><![CDATA[]]></text></staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="5" y="219" width="546" height="19">
                    <printWhenExpression><![CDATA[!"CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="5" y="219" width="285" height="19">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="300" y="219" width="250" height="19" forecolor="#B42318">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{motivo_cancelacion}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement style="Header" x="0" y="0" width="56" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="56" y="0" width="168" height="20"/><textElement><paragraph leftIndent="6"/></textElement><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="224" y="0" width="54" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Existencia]]></text></staticText>
            <staticText><reportElement style="Header" x="278" y="0" width="46" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Cantidad]]></text></staticText>
            <staticText><reportElement style="Header" x="324" y="0" width="58" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Quedan]]></text></staticText>
            <staticText><reportElement style="Header" x="382" y="0" width="50" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Conforme]]></text></staticText>
            <staticText><reportElement style="Header" x="432" y="0" width="62" height="20"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Center"/><text><![CDATA[Costo unit.]]></text></staticText>
            <staticText><reportElement style="Header" x="494" y="0" width="62" height="20"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Center"/><text><![CDATA[Subtotal]]></text></staticText>
            <rectangle>
                <reportElement x="0" y="20" width="556" height="2" forecolor="#E0A526" backcolor="#E0A526"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="56" height="18"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="56" y="0" width="168" height="18"/><textElement><paragraph leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="224" y="0" width="54" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{existencia_bodega}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="278" y="0" width="46" height="18"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="CellQuedan" x="324" y="0" width="58" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{existencia_bodega} == null || $F{cantidad} == null ? null : Integer.valueOf($F{existencia_bodega} - $F{cantidad})]]></textFieldExpression></textField>
            <!-- Casilla para que quien recibe marque cada línea -->
            <staticText><reportElement style="Cell" forecolor="#8A99AD" x="382" y="0" width="50" height="18"/><textElement textAlignment="Center"><font size="11"/></textElement><text><![CDATA[☐]]></text></staticText>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="432" y="0" width="62" height="18"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="494" y="0" width="62" height="18"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{sub_total}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <staticText>
                <reportElement x="0" y="4" width="360" height="12" forecolor="#7B8798"/>
                <textElement><font size="6.5" isItalic="true"/></textElement>
                <text><![CDATA[Documento de control interno de inventario. No tiene validez fiscal.]]></text>
            </staticText>
            <textField>
                <reportElement x="436" y="4" width="85" height="12" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="521" y="4" width="35" height="12" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="152">
            <!-- Pie de tabla con los totales -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="556" height="20" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="0" width="556" height="8" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField>
                <reportElement style="Base" x="8" y="0" width="300" height="20" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($V{CANTIDAD_LINEAS} == null ? 0 : $V{CANTIDAD_LINEAS}) + ($V{CANTIDAD_LINEAS} != null && $V{CANTIDAD_LINEAS} == 1 ? " producto" : " productos")
    + "  ·  " + String.format("%,d", $V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}) + ($V{TOTAL_UNIDADES} != null && $V{TOTAL_UNIDADES} == 1 ? " unidad" : " unidades")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Base" x="300" y="0" width="150" height="20" forecolor="#F4D58A"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[TOTAL AL COSTO]]></text>
            </staticText>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true">
                <reportElement style="Base" x="446" y="0" width="104" height="20" forecolor="#E0A526"><printWhenExpression><![CDATA[$P{VER_COSTOS}]]></printWhenExpression></reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="0" y="25" width="420" height="20" forecolor="#66758A"/>
                <textElement verticalAlignment="Top"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA[("PENDIENTE".equals($F{estado}) ? "Unidades reservadas: ya salieron de la bodega y no pueden despacharse otra vez."
    : "REALIZADO".equals($F{estado}) ? "Registrado en el kardex del destino como «Ingreso por despacho»."
    : "Las unidades regresaron a la bodega de origen y quedaron en su kardex.")
    + " «Quedan» es la existencia de la bodega tras este despacho."]]></textFieldExpression>
            </textField>

            <!-- Recepción en el destino -->
            <rectangle radius="6">
                <reportElement mode="Opaque" x="0" y="50" width="556" height="40" forecolor="#14325C" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.8" lineColor="#14325C"/></graphicElement>
            </rectangle>
            <rectangle radius="6">
                <reportElement x="1" y="51" width="91" height="38" forecolor="#EEF4FC" backcolor="#EEF4FC"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="80" y="51" width="12" height="38" forecolor="#EEF4FC" backcolor="#EEF4FC"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Label" x="8" y="50" width="80" height="40" forecolor="#14325C"/>
                <textElement verticalAlignment="Middle"><font size="6.5"/></textElement>
                <text><![CDATA[RECEPCIÓN EN
DESTINO]]></text>
            </staticText>
            <staticText>
                <reportElement style="Base" x="104" y="57" width="120" height="14"/>
                <textElement verticalAlignment="Middle" markup="styled"><font size="8"/></textElement>
                <text><![CDATA[<style size='11' forecolor='#8A99AD'>☐</style> Recibido conforme]]></text>
            </staticText>
            <staticText>
                <reportElement style="Base" x="104" y="72" width="120" height="14"/>
                <textElement verticalAlignment="Middle" markup="styled"><font size="8"/></textElement>
                <text><![CDATA[<style size='11' forecolor='#8A99AD'>☐</style> Con diferencias]]></text>
            </staticText>
            <staticText><reportElement style="Base" x="230" y="58" width="54" height="10" forecolor="#66758A"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><text><![CDATA[Fecha y hora]]></text></staticText>
            <line><reportElement x="286" y="67" width="110" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="0.8" lineColor="#23344D"/></graphicElement></line>
            <staticText><reportElement style="Base" x="230" y="73" width="54" height="10" forecolor="#66758A"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><text><![CDATA[Observaciones]]></text></staticText>
            <line><reportElement x="286" y="82" width="260" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="0.8" lineColor="#23344D"/></graphicElement></line>

            <!-- Firmas -->
            <line><reportElement x="0" y="124" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <line><reportElement x="193" y="124" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <line><reportElement x="386" y="124" width="170" height="1" forecolor="#23344D"/><graphicElement><pen lineWidth="1" lineColor="#23344D"/></graphicElement></line>
            <staticText><reportElement style="Label" x="0" y="128" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[DESPACHÓ · BODEGA]]></text></staticText>
            <staticText><reportElement style="Label" x="193" y="128" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[RECIBIÓ · DESTINO]]></text></staticText>
            <staticText><reportElement style="Label" x="386" y="128" width="170" height="8"/><textElement textAlignment="Center"/><text><![CDATA[AUTORIZÓ · ADMINISTRADOR]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Base" x="0" y="138" width="170" height="12"/><textElement textAlignment="Center"><font size="7.5"/></textElement><textFieldExpression><![CDATA[$F{despachado_por}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Base" x="193" y="138" width="170" height="12"/><textElement textAlignment="Center"><font size="7.5"/></textElement><textFieldExpression><![CDATA[$F{recibido_por}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Base" x="386" y="138" width="170" height="12"/>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA["REALIZADO".equals($F{estado}) ? $F{resuelto_por} : ""]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Base" x="386" y="138" width="170" height="12" forecolor="#66758A">
                    <printWhenExpression><![CDATA[!"REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <text><![CDATA[Nombre, firma y sello]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
