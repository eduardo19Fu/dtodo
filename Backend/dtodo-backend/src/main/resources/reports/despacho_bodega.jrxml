            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="366" y="0" width="60" height="22"/><textElement textAlignment="Right"><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="426" y="0" width="62" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="488" y="0" width="68" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{sub_total}]]></textFieldExpression></textField>
