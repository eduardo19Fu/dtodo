            <!-- ===== Avance en tres pasos ===== -->
            <rectangle radius="4">
                <reportElement x="0" y="151" width="182" height="19" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" mode="Transparent" x="0" y="151" width="182" height="19" forecolor="#FFFFFF"/>
