<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="despacho_bodega" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail"
              columnWidth="556" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24"
              isSummaryWithPageHeaderAndFooter="true" uuid="b3f1c6a4-7d0e-4f68-9a52-2c8e5d7b1a90">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>
    <style name="Label" style="Base" forecolor="#66758A" fontSize="7" isBold="true"/>
    <style name="Value" style="Base" fontSize="9"/>

    <parameter name="ID_DESPACHO" class="java.lang.Long"/>

    <queryString language="SQL"><![CDATA[
        SELECT d.id_despacho,
               d.fecha_registro,
               d.fecha_resolucion,
               d.estado,
               d.total,
               d.recibido_por,
               d.observaciones,
               d.motivo_cancelacion,
               b.nombre AS bodega,
               b.ubicacion AS bodega_ubicacion,
               s.nombre AS sucursal_destino,
               s.direccion AS sucursal_direccion,
               TRIM(CONCAT(COALESCE(ud.primer_nombre, ''), ' ', COALESCE(ud.apellido, ''))) AS despachado_por,
               TRIM(CONCAT(COALESCE(ur.primer_nombre, ''), ' ', COALESCE(ur.apellido, ''))) AS resuelto_por,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               dd.cantidad,
               dd.precio_unitario,
               dd.sub_total,
               dd.existencia_bodega
          FROM despachos_bodega d
          INNER JOIN bodegas b ON b.id_bodega = d.id_bodega
          INNER JOIN sucursales s ON s.id_sucursal = d.id_sucursal_destino
          INNER JOIN usuarios ud ON ud.id_usuario = d.id_usuario_despacha
          LEFT JOIN usuarios ur ON ur.id_usuario = d.id_usuario_resuelve
          INNER JOIN despachos_bodega_detalle dd ON dd.id_despacho = d.id_despacho
          INNER JOIN productos p ON p.id_producto = dd.id_producto
         WHERE d.id_despacho = $P{ID_DESPACHO}
         ORDER BY p.nombre, p.cod_producto
    ]]></queryString>

    <field name="id_despacho" class="java.lang.Long"/>
    <field name="fecha_registro" class="java.sql.Timestamp"/>
    <field name="fecha_resolucion" class="java.sql.Timestamp"/>
    <field name="estado" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="recibido_por" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="motivo_cancelacion" class="java.lang.String"/>
    <field name="bodega" class="java.lang.String"/>
    <field name="bodega_ubicacion" class="java.lang.String"/>
    <field name="sucursal_destino" class="java.lang.String"/>
    <field name="sucursal_direccion" class="java.lang.String"/>
    <field name="despachado_por" class="java.lang.String"/>
    <field name="resuelto_por" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_unitario" class="java.math.BigDecimal"/>
    <field name="sub_total" class="java.math.BigDecimal"/>
    <field name="existencia_bodega" class="java.lang.Integer"/>

    <variable name="CANTIDAD_LINEAS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="214">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="466" height="56" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="80" height="56"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="300" height="32" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="16"/></textElement>
                <text><![CDATA[Comprobante de despacho]]></text>
            </staticText>
            <staticText>
                <reportElement x="90" y="32" width="300" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="16"/></textElement>
                <text><![CDATA[Traslado de existencias de bodega a sucursal]]></text>
            </staticText>
            <textField>
                <reportElement x="390" y="0" width="166" height="32" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="15" isBold="true"/><paragraph rightIndent="16"/></textElement>
                <textFieldExpression><![CDATA["No. " + String.format("%06d", $F{id_despacho})]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="390" y="32" width="166" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="16"/></textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- Estado del despacho -->
            <staticText>
                <reportElement x="0" y="66" width="556" height="20" forecolor="#B54708" backcolor="#FEF0C7" mode="Opaque">
                    <printWhenExpression><![CDATA["PENDIENTE".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[PENDIENTE DE APROBACIÓN · Las existencias aún no ingresan a la sucursal destino]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="66" width="556" height="20" forecolor="#067647" backcolor="#D1FADF" mode="Opaque">
                    <printWhenExpression><![CDATA["REALIZADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[DESPACHO REALIZADO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="66" width="556" height="20" forecolor="#B42318" backcolor="#FEE4E2" mode="Opaque">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[DESPACHO CANCELADO]]></text>
            </staticText>

            <!-- Datos generales: columna izquierda -->
            <staticText><reportElement style="Label" x="0" y="96" width="270" height="10"/><text><![CDATA[BODEGA DE ORIGEN]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="Value" x="0" y="106" width="270" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{bodega}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Base" x="0" y="120" width="270" height="12" forecolor="#66758A"/><textFieldExpression><![CDATA[$F{bodega_ubicacion}]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="0" y="140" width="270" height="10"/><text><![CDATA[DESPACHADO POR]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="Value" x="0" y="150" width="270" height="14"/><textFieldExpression><![CDATA[$F{despachado_por}]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="0" y="172" width="270" height="10"/><text><![CDATA[RECIBIDO POR]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="Value" x="0" y="182" width="270" height="14"/><textFieldExpression><![CDATA[$F{recibido_por}]]></textFieldExpression></textField>

            <!-- Datos generales: columna derecha -->
            <staticText><reportElement style="Label" x="286" y="96" width="270" height="10"/><text><![CDATA[SUCURSAL DESTINO]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement style="Value" x="286" y="106" width="270" height="14"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{sucursal_destino}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Base" x="286" y="120" width="270" height="12" forecolor="#66758A"/><textFieldExpression><![CDATA[$F{sucursal_direccion}]]></textFieldExpression></textField>

            <staticText><reportElement style="Label" x="286" y="140" width="270" height="10"/><text><![CDATA[FECHA DE REGISTRO]]></text></staticText>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement style="Value" x="286" y="150" width="270" height="14"/><textFieldExpression><![CDATA[$F{fecha_registro}]]></textFieldExpression></textField>

            <staticText>
                <reportElement style="Label" x="286" y="172" width="270" height="10">
                    <printWhenExpression><![CDATA[$F{fecha_resolucion} != null]]></printWhenExpression>
                </reportElement>
                <text><![CDATA[RESUELTO EL]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement style="Value" x="286" y="182" width="270" height="14">
                    <printWhenExpression><![CDATA[$F{fecha_resolucion} != null]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$F{fecha_resolucion}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="205" width="556" height="1" forecolor="#B9C9DC"/></line>
        </band>
    </title>

