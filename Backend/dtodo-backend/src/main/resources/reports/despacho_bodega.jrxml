                <textFieldExpression><![CDATA["1 · REGISTRADO <style forecolor='#F4D58A'>" + ($F{fecha_registro} == null ? "" : new java.text.SimpleDateFormat("dd/MM HH:mm").format($F{fecha_registro})) + "</style>"]]></textFieldExpression>
