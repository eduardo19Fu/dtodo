            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="Value" x="0" y="89" width="556" height="14" forecolor="#B42318">
                    <printWhenExpression><![CDATA["CANCELADO".equals($F{estado})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$F{motivo_cancelacion}]]></textFieldExpression>
            </textField>

            <!-- Firmas -->
            <line><reportElement x="0" y="190" width="170" height="1" forecolor="#23344D"/></line>
