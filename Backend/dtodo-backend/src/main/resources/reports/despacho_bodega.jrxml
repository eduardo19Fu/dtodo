<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="despacho_bodega" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail"
              columnWidth="556" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="24"
              isSummaryWithPageHeaderAndFooter="true" uuid="b3f1c6a4-7d0e-4f68-9a52-2c8e5d7b1a90">

    <!-- Guía de despacho. Se lee como una guía de envío: azul marino con franja dorada y chevrones, una etiqueta con
         el total de unidades y el destino en grande, el avance en tres pasos, una ficha de datos con celdas de
         formulario, columnas "Quedan" (existencia tras el despacho) y "Conforme" para que quien recibe marque cada
         línea, y un bloque de recepción en el destino. Es el par del comprobante de devolución, pero con identidad
         propia para distinguirlos a simple vista. -->

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#14325C" forecolor="#FFFFFF"
           fontSize="7.5" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" fontSize="7.5" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} != null && $V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#F8FAFD"/>
        </conditionalStyle>
    </style>
    <!-- "Quedan": gris; rojo y en negrita cuando el despacho deja la bodega sin existencias de ese producto -->
    <style name="CellQuedan" style="Cell" forecolor="#66758A">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{existencia_bodega} != null && $F{existencia_bodega} - $F{cantidad} <= 0]]></conditionExpression>
            <style forecolor="#B42318" isBold="true"/>
        </conditionalStyle>
    </style>
    <style name="Label" style="Base" forecolor="#66758A" fontSize="6.5" isBold="true"/>
    <style name="Value" style="Base" fontSize="8.5"/>
    <!-- Celdas de la ficha de datos, estilo formulario -->
    <style name="CeldaEtiqueta" style="Base" mode="Opaque" backcolor="#EEF4FC" forecolor="#66758A" fontSize="6" isBold="true" vTextAlign="Middle">
        <box leftPadding="5" rightPadding="4"><pen lineWidth="0.6" lineColor="#C5D2E2"/></box>
    </style>
    <style name="CeldaValor" style="Base" mode="Opaque" backcolor="#FFFFFF" fontSize="8.5" vTextAlign="Middle">
        <box leftPadding="5" rightPadding="4"><pen lineWidth="0.6" lineColor="#C5D2E2"/></box>
    </style>

    <!-- Colores según el estado: PENDIENTE (ámbar), REALIZADO (verde), CANCELADO (rojo) -->
    <style name="ColorEstado" style="Base" forecolor="#B54708">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#067647"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#B42318"/>
        </conditionalStyle>
    </style>
    <style name="RellenoEstado" style="Base" mode="Opaque" forecolor="#FFFFFF" backcolor="#B54708">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#067647"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#B42318"/>
        </conditionalStyle>
    </style>
    <style name="FondoEstado" style="Base" mode="Opaque" backcolor="#FEF0C7">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#D1FADF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#FEE4E2"/>
        </conditionalStyle>
    </style>
    <!-- Segundo paso del avance: ámbar claro mientras espera, verde o rojo al resolverse -->
    <style name="PasoResolucion" style="Base" mode="Opaque" backcolor="#FEF0C7" forecolor="#B54708">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#067647" forecolor="#FFFFFF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#B42318" forecolor="#FFFFFF"/>
        </conditionalStyle>
    </style>
    <!-- Tercer paso: gris hasta que las unidades ingresan (verde) o regresan a la bodega (rojo) -->
    <style name="PasoIngreso" style="Base" mode="Opaque" backcolor="#EAEFF5" forecolor="#8A99AD">
        <conditionalStyle>
            <conditionExpression><![CDATA["REALIZADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#067647" forecolor="#FFFFFF"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["CANCELADO".equals($F{estado})]]></conditionExpression>
            <style backcolor="#B42318" forecolor="#FFFFFF"/>
        </conditionalStyle>
    </style>

    <parameter name="ID_DESPACHO" class="java.lang.Long"/>

    <parameter name="VER_COSTOS" class="java.lang.Boolean"><defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression></parameter>

    <queryString language="SQL"><![CDATA[
        SELECT d.id_despacho,
               d.fecha_registro,
               d.fecha_resolucion,
               d.estado,
               d.total,
               d.recibido_por,
               d.observaciones,
               d.motivo_cancelacion,
               b.nombre AS bodega,
               b.ubicacion AS bodega_ubicacion,
               COALESCE(s.nombre, CONCAT('Bodega ', bd.nombre)) AS sucursal_destino,
               COALESCE(s.direccion, bd.ubicacion) AS sucursal_direccion,
               CASE WHEN d.id_bodega_destino IS NULL THEN 0 ELSE 1 END AS es_traslado,
               TRIM(CONCAT(COALESCE(ud.primer_nombre, ''), ' ', COALESCE(ud.apellido, ''))) AS despachado_por,
               TRIM(CONCAT(COALESCE(ur.primer_nombre, ''), ' ', COALESCE(ur.apellido, ''))) AS resuelto_por,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               dd.cantidad,
               dd.precio_unitario,
               dd.sub_total,
               dd.existencia_bodega
          FROM despachos_bodega d
          INNER JOIN bodegas b ON b.id_bodega = d.id_bodega
          LEFT JOIN sucursales s ON s.id_sucursal = d.id_sucursal_destino
          LEFT JOIN bodegas bd ON bd.id_bodega = d.id_bodega_destino
          INNER JOIN usuarios ud ON ud.id_usuario = d.id_usuario_despacha
          LEFT JOIN usuarios ur ON ur.id_usuario = d.id_usuario_resuelve
          INNER JOIN despachos_bodega_detalle dd ON dd.id_despacho = d.id_despacho
          INNER JOIN productos p ON p.id_producto = dd.id_producto
         WHERE d.id_despacho = $P{ID_DESPACHO}
         ORDER BY p.nombre, p.cod_producto
    ]]></queryString>

    <field name="id_despacho" class="java.lang.Long"/>
    <field name="fecha_registro" class="java.sql.Timestamp"/>
    <field name="fecha_resolucion" class="java.sql.Timestamp"/>
    <field name="estado" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="recibido_por" class="java.lang.String"/>
    <field name="observaciones" class="java.lang.String"/>
    <field name="motivo_cancelacion" class="java.lang.String"/>
    <field name="bodega" class="java.lang.String"/>
    <field name="bodega_ubicacion" class="java.lang.String"/>
    <field name="sucursal_destino" class="java.lang.String"/>
    <field name="sucursal_direccion" class="java.lang.String"/>
    <field name="es_traslado" class="java.lang.Integer"/>
    <field name="despachado_por" class="java.lang.String"/>
    <field name="resuelto_por" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Integer"/>
    <field name="precio_unitario" class="java.math.BigDecimal"/>
    <field name="sub_total" class="java.math.BigDecimal"/>
    <field name="existencia_bodega" class="java.lang.Integer"/>

    <variable name="CANTIDAD_LINEAS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidad}]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="244">
            <!-- ===== Encabezado: azul marino con franja dorada y chevrones de envío ===== -->
            <rectangle radius="7">
                <reportElement x="76" y="0" width="480" height="46" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle radius="1">
                <reportElement x="76" y="49" width="480" height="2" forecolor="#E0A526" backcolor="#E0A526"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="68" height="46"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText><reportElement style="Base" x="338" y="5" width="16" height="34" forecolor="#F4D58A"/><textElement verticalAlignment="Top"><font size="26" isBold="true"/></textElement><text><![CDATA[»]]></text></staticText>
            <staticText><reportElement style="Base" x="351" y="5" width="16" height="34" forecolor="#E8B84A"/><textElement verticalAlignment="Top"><font size="26" isBold="true"/></textElement><text><![CDATA[»]]></text></staticText>
            <staticText><reportElement style="Base" x="364" y="5" width="16" height="34" forecolor="#E0A526"/><textElement verticalAlignment="Top"><font size="26" isBold="true"/></textElement><text><![CDATA[»]]></text></staticText>
            <staticText>
                <reportElement style="Base" x="76" y="3" width="262" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="14" isBold="true"/><paragraph leftIndent="14"/></textElement>
                <text><![CDATA[Comprobante de despacho]]></text>
            </staticText>
            <staticText>
                <reportElement style="Base" x="76" y="28" width="262" height="12" forecolor="#F4D58A"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/><paragraph leftIndent="14"/></textElement>
                <text><![CDATA[GUÍA DE TRASLADO DE EXISTENCIAS]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="396" y="3" width="160" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="14" isBold="true"/><paragraph rightIndent="14"/></textElement>
                <textFieldExpression><![CDATA["No. " + String.format("%06d", $F{id_despacho})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="396" y="28" width="160" height="12" forecolor="#C9D8EE"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/><paragraph rightIndent="14"/></textElement>
                <textFieldExpression><![CDATA["Generado: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <!-- ===== Franja de estado ===== -->
            <rectangle radius="8">
                <reportElement style="FondoEstado" x="0" y="59" width="556" height="16"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <ellipse>
                <reportElement style="RellenoEstado" x="3" y="62" width="10" height="10"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </ellipse>
            <textField>
                <reportElement style="Base" x="3" y="62" width="10" height="10" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado}) ? "…" : "REALIZADO".equals($F{estado}) ? "✓" : "✗"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="ColorEstado" x="18" y="59" width="524" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["PENDIENTE".equals($F{estado})
    ? "PENDIENTE DE APROBACIÓN · Las unidades salieron de la bodega y aún no ingresan al destino"
    : "REALIZADO".equals($F{estado})
        ? "DESPACHO REALIZADO · Las unidades ya forman parte del inventario del destino"
        : "DESPACHO CANCELADO · Las unidades regresaron al inventario de la bodega de origen"]]></textFieldExpression>
            </textField>

            <!-- ===== Etiqueta de envío: el destino es el protagonista ===== -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="83" width="556" height="60" forecolor="#14325C" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="1.2" lineColor="#14325C"/></graphicElement>
            </rectangle>
            <rectangle radius="8">
                <reportElement x="0" y="83" width="92" height="60" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="80" y="83" width="12" height="60" forecolor="#14325C" backcolor="#14325C"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Base" x="0" y="90" width="92" height="8" forecolor="#E0A526"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
                <text><![CDATA[TOTAL A ENVIAR]]></text>
            </staticText>
            <textField evaluationTime="Report">
                <reportElement style="Base" x="0" y="98" width="92" height="26" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="22" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.format("%,d", $V{TOTAL_UNIDADES})]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Base" x="0" y="124" width="92" height="10" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == 1 ? "UNIDAD" : "UNIDADES"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement style="Base" x="104" y="90" width="236" height="9" forecolor="#E0A526"/>
                <textElement verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[Integer.valueOf(1).equals($F{es_traslado}) ? "▤ BODEGA DESTINO · TRASLADO" : "▣ SUCURSAL DESTINO"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Base" x="104" y="100" width="236" height="21" forecolor="#14325C"/>
                <textElement verticalAlignment="Middle"><font size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{sucursal_destino}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="104" y="122" width="236" height="12" forecolor="#66758A"/>
                <textElement verticalAlignment="Middle"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$F{sucursal_direccion}]]></textFieldExpression>
            </textField>

            <line direction="TopDown">
                <reportElement x="348" y="92" width="1" height="42" forecolor="#D9E3EF"/>
                <graphicElement><pen lineWidth="1" lineColor="#D9E3EF"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="Base" x="330" y="102" width="16" height="22" forecolor="#E0A526"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="17" isBold="true"/></textElement>
                <text><![CDATA[«]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="360" y="92" width="188" height="8"/>
                <textElement verticalAlignment="Middle"><font size="6"/></textElement>
                <text><![CDATA[▤ SALE DE]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement style="Base" x="360" y="101" width="188" height="14"/>
                <textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{bodega}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="360" y="116" width="188" height="10" forecolor="#66758A"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{bodega_ubicacion}]]></textFieldExpression>
