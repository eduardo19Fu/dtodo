<?xml version="1.0" encoding="UTF-8"?>
<!-- Comisiones de vendedores de un año. Plantilla escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Se llena con una lista de FilaComisionDto, no con SQL.
     Mismo lenguaje visual que la proforma; se exporta a PDF y a Excel (la cabecera y las filas son celdas con estilo para que
     el Excel conserve colores y alineación). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comisiones_anio" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="7d2a9c41-5b6e-4f83-9a17-c3e08b52d604">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#1F2A44"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2B3990" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><bottomPen lineWidth="0.5" lineColor="#E1E7F3"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8FD"/>
        </conditionalStyle>
    </style>
    <style name="Completo" style="Cell" isBold="true" forecolor="#6B7A90">
        <conditionalStyle>
            <conditionExpression><![CDATA[Boolean.TRUE.equals($F{completoAnio})]]></conditionExpression>
            <style forecolor="#087453"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[Boolean.FALSE.equals($F{completoAnio})]]></conditionExpression>
            <style forecolor="#B83A35"/>
        </conditionalStyle>
    </style>

    <parameter name="ANIO" class="java.lang.Integer"/>
    <parameter name="FORMATO" class="java.lang.String"/>
    <parameter name="ESTADO" class="java.lang.String"/>
    <parameter name="METAS" class="java.lang.String"/>
    <parameter name="TOTAL_ENTREGADO" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_DEVUELTO" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_NETO" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_COMISION" class="java.math.BigDecimal"/>
    <parameter name="LIQUIDADO" class="java.lang.Boolean"/>

    <field name="vendedor" class="java.lang.String"/>
    <field name="montoEntregado" class="java.math.BigDecimal"/>
    <field name="montoDevuelto" class="java.math.BigDecimal"/>
    <field name="montoNeto" class="java.math.BigDecimal"/>
    <field name="metaAlcanzada" class="java.math.BigDecimal"/>
    <field name="porcentaje" class="java.math.BigDecimal"/>
    <field name="comision" class="java.math.BigDecimal"/>
    <field name="faltaParaSiguiente" class="java.math.BigDecimal"/>
    <field name="completoAnio" class="java.lang.Boolean"/>

    <title>
        <band height="136">
            <!-- Logo sin fondo y panel azul del reporte -->
            <image scaleImage="RetainShape" hAlign="Left">
                <reportElement x="0" y="2" width="130" height="68"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo-proforma.png")]]></imageExpression>
            </image>
            <rectangle radius="9">
                <reportElement mode="Opaque" x="236" y="2" width="566" height="66" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="252" y="8" width="260" height="11" forecolor="#C3CFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <text><![CDATA[VENTAS MAYORISTAS · COMISIONES]]></text>
            </staticText>
            <textField>
                <reportElement x="252" y="19" width="380" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="17" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Comisiones de vendedores " + $P{ANIO}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="252" y="46" width="380" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{ESTADO}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="660" y="10" width="130" height="10" forecolor="#C3CFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[GENERADO]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="640" y="21" width="150" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

            <!-- Las metas y la regla de cálculo -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="80" width="802" height="46" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="80" width="5" height="46" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="16" y="86" width="776" height="16" forecolor="#1F2A44"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Metas del año: " + $P{METAS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="16" y="104" width="776" height="16" forecolor="#6B7A90"/>
                <textElement verticalAlignment="Middle"><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Porcentaje plano sobre lo entregado menos lo devuelto (base) según la meta más alta alcanzada. Solo cobra quien completó el año.]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement style="Header" x="0" y="2" width="172" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><text><![CDATA[Vendedor]]></text></staticText>
            <staticText><reportElement style="Header" x="172" y="2" width="88" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Entregado]]></text></staticText>
            <staticText><reportElement style="Header" x="260" y="2" width="78" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Devuelto]]></text></staticText>
            <staticText><reportElement style="Header" x="338" y="2" width="88" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Base (neto)]]></text></staticText>
            <staticText><reportElement style="Header" x="426" y="2" width="88" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Meta alcanzada]]></text></staticText>
            <staticText><reportElement style="Header" x="514" y="2" width="45" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[%]]></text></staticText>
            <staticText><reportElement style="Header" x="559" y="2" width="92" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Comisión]]></text></staticText>
            <staticText><reportElement style="Header" x="651" y="2" width="85" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><text><![CDATA[Falta p/ siguiente]]></text></staticText>
            <staticText><reportElement style="Header" x="736" y="2" width="66" height="26"/><textElement textAlignment="Center"/><text><![CDATA[Completó el año]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="26">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="172" height="26"/><textElement textAlignment="Left"><font size="9" isBold="true"/><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="172" y="0" width="88" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{montoEntregado}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="260" y="0" width="78" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{montoDevuelto}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="338" y="0" width="88" height="26"/><textElement textAlignment="Right"><font size="9" isBold="true"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{montoNeto}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="426" y="0" width="88" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{metaAlcanzada}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="514" y="0" width="45" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{porcentaje}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="559" y="0" width="92" height="26" forecolor="#2B3990"/><textElement textAlignment="Right"><font size="10" isBold="true"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{comision}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="651" y="0" width="85" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{faltaParaSiguiente}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Completo" x="736" y="0" width="66" height="26"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{completoAnio} == null ? "Sin definir" : ($F{completoAnio} ? "Sí" : "No")]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="2" width="802" height="1" forecolor="#E1E7F3">
                <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
            </reportElement></line>
            <staticText>
                <reportElement x="0" y="5" width="300" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Comisiones de vendedores · D'Todo]]></text>
            </staticText>
            <textField>
                <reportElement x="642" y="5" width="115" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="5" width="35" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="76">
            <staticText>
                <reportElement x="0" y="40" width="400" height="26" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} == null || $V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[No hay vendedores para este año.]]></text>
            </staticText>
            <!-- Fila de totales en azul, alineada con las columnas -->
            <staticText><reportElement style="Header" x="0" y="8" width="172" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="8"/></textElement><text><![CDATA[Totales:]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement style="Header" x="172" y="8" width="88" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_ENTREGADO}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Header" x="260" y="8" width="78" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_DEVUELTO}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement style="Header" x="338" y="8" width="88" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_NETO}]]></textFieldExpression></textField>
            <staticText><reportElement style="Header" x="426" y="8" width="133" height="26"/><text><![CDATA[]]></text></staticText>
            <textField pattern="#,##0.00"><reportElement style="Header" x="559" y="8" width="92" height="26"/><textElement textAlignment="Right"><font size="10"/><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_COMISION}]]></textFieldExpression></textField>
            <staticText><reportElement style="Header" x="651" y="8" width="151" height="26"/><text><![CDATA[]]></text></staticText>
        </band>
    </summary>
</jasperReport>
