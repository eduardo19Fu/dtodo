<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bodega_movimientos" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="7e2b4d10-93c5-4a8b-b6f2-5d1e8a0c3f47">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>
    <style name="EntradaCell" style="Cell" forecolor="#067647" isBold="true"/>
    <style name="SalidaCell" style="Cell" forecolor="#B42318" isBold="true"/>

    <parameter name="ID_BODEGA" class="java.lang.Integer"/>
    <parameter name="BODEGA" class="java.lang.String"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT m.fecha_movimiento AS fecha,
               CASE m.tipo_movimiento
                   WHEN 'INGRESO' THEN 'Ingreso'
                   WHEN 'IMPORTACION' THEN 'Importación'
                   WHEN 'REDUCCION' THEN 'Reducción'
                   WHEN 'ELIMINACION' THEN 'Eliminación'
                   WHEN 'DESPACHO' THEN 'Despacho'
                   WHEN 'ANULACION_DESPACHO' THEN 'Cancelación de despacho'
                   WHEN 'INGRESO_DESPACHO' THEN 'Ingreso por despacho'
                   WHEN 'REVERSION_DESPACHO' THEN 'Reversión de despacho'
                   ELSE m.tipo_movimiento
               END AS tipo,
               p.cod_producto AS codigo,
               p.nombre AS producto,
               CAST(CASE WHEN m.tipo_movimiento IN ('INGRESO', 'IMPORTACION', 'ANULACION_DESPACHO', 'INGRESO_DESPACHO')
                         THEN m.cantidad ELSE 0 END AS SIGNED) AS entrada,
               CAST(CASE WHEN m.tipo_movimiento IN ('INGRESO', 'IMPORTACION', 'ANULACION_DESPACHO', 'INGRESO_DESPACHO')
                         THEN 0 ELSE m.cantidad END AS SIGNED) AS salida,
               CAST(m.stock_final AS SIGNED) AS saldo,
               COALESCE(u.usuario, '') AS usuario,
               COALESCE(m.motivo, CASE WHEN m.tipo_documento_origen = 'DESPACHO_BODEGA'
                                       THEN CONCAT('Despacho #', m.id_documento_origen) END, '') AS detalle
          FROM movimientos_bodega m
          INNER JOIN productos p ON p.id_producto = m.id_producto
          LEFT JOIN usuarios u ON u.id_usuario = m.id_usuario
         WHERE m.id_bodega = $P{ID_BODEGA}
           AND m.fecha_movimiento >= $P{FECHA_INICIO}
           AND m.fecha_movimiento < $P{FECHA_FIN_EXCLUSIVA}
         ORDER BY m.fecha_movimiento, m.id_movimiento
    ]]></queryString>

    <field name="fecha" class="java.sql.Timestamp"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="entrada" class="java.lang.Long"/>
    <field name="salida" class="java.lang.Long"/>
    <field name="saldo" class="java.lang.Long"/>
    <field name="usuario" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>

    <variable name="CANTIDAD_MOVIMIENTOS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <variable name="TOTAL_ENTRADAS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{entrada}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_SALIDAS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{salida}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="478" height="24" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="18"/></textElement>
                <text><![CDATA[Movimientos de bodega]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="24" width="478" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{BODEGA}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="568" y="0" width="234" height="24" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{RANGO}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="24" width="234" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Bitácora cronológica de ingresos, importaciones, reducciones, eliminaciones y despachos de la bodega.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText><reportElement style="Header" x="0" y="0" width="100" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement style="Header" x="100" y="0" width="95" height="28"/><text><![CDATA[Tipo]]></text></staticText>
            <staticText><reportElement style="Header" x="195" y="0" width="75" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="270" y="0" width="170" height="28"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="440" y="0" width="55" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Entrada]]></text></staticText>
            <staticText><reportElement style="Header" x="495" y="0" width="55" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Salida]]></text></staticText>
            <staticText><reportElement style="Header" x="550" y="0" width="60" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Saldo]]></text></staticText>
            <staticText><reportElement style="Header" x="610" y="0" width="80" height="28"/><text><![CDATA[Usuario]]></text></staticText>
            <staticText><reportElement style="Header" x="690" y="0" width="112" height="28"/><text><![CDATA[Detalle]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="100" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="100" y="0" width="95" height="24"/><textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="195" y="0" width="75" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="270" y="0" width="170" height="24"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="EntradaCell" x="440" y="0" width="55" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{entrada}.longValue() == 0 ? null : $F{entrada}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="SalidaCell" x="495" y="0" width="55" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{salida}.longValue() == 0 ? null : $F{salida}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="550" y="0" width="60" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{saldo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="610" y="0" width="80" height="24"/><textFieldExpression><![CDATA[$F{usuario}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="690" y="0" width="112" height="24"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{detalle}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="52">
            <line><reportElement x="0" y="8" width="802" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="330" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[No hay movimientos de bodega en el período seleccionado.]]></text>
            </staticText>
            <staticText><reportElement x="365" y="16" width="75" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Movimientos:]]></text></staticText>
            <textField><reportElement x="440" y="16" width="40" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{CANTIDAD_MOVIMIENTOS} == null ? 0 : $V{CANTIDAD_MOVIMIENTOS}]]></textFieldExpression></textField>
            <staticText><reportElement x="495" y="16" width="55" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Entradas:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="550" y="16" width="50" height="20" forecolor="#067647"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_ENTRADAS} == null ? 0 : $V{TOTAL_ENTRADAS}]]></textFieldExpression></textField>
            <staticText><reportElement x="615" y="16" width="55" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Salidas:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="670" y="16" width="50" height="20" forecolor="#B42318"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_SALIDAS} == null ? 0 : $V{TOTAL_SALIDAS}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
