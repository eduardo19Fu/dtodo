<?xml version="1.0" encoding="UTF-8"?>
<!-- Nota de envío (carga a ruta): los pedidos mayoristas de una ruta que se cargan o salen ese día. Escrita a mano en
     formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7, que cambia el formato y la librería del
     proyecto no lo entiende. Sin precios ni firma de recibido. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="nota_envio" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="7f3c9a2e-5b81-4d06-a4e7-1c8b6d0f5505">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box topPadding="3" bottomPadding="3" leftPadding="4" rightPadding="4"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>

    <parameter name="ID_RUTA" class="java.lang.Integer"/>
    <parameter name="RUTA" class="java.lang.String"/>
    <parameter name="FECHA" class="java.lang.String"/>
    <parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>

    <queryString language="SQL"><![CDATA[
        SELECT pr.no_proforma AS no_proforma,
               c.nombre_negocio AS negocio,
               c.nombre AS cliente,
               c.direccion AS direccion,
               c.contacto AS contacto,
               c.telefono_contacto AS telefono,
               (SELECT COALESCE(SUM(d.cantidad), 0) FROM proformas_detalle d WHERE d.id_proforma = pr.id_proforma) AS unidades,
               DATE_FORMAT(pr.fecha_entrega_estimada, '%d/%m/%Y') AS entrega,
               pr.estado_pedido AS estado
          FROM proformas pr
          INNER JOIN clientes c ON c.id_cliente = pr.id_cliente
         WHERE pr.id_ruta = $P{ID_RUTA}
           AND pr.tipo_proforma = 'MAYORISTA'
           AND pr.id_estado != 4
           AND (pr.estado_pedido = 'EMPACADA'
                OR (pr.estado_pedido = 'EN_RUTA'
                    AND EXISTS (SELECT 1 FROM proformas_etapas e
                                 WHERE e.id_proforma = pr.id_proforma AND e.etapa = 'EN_RUTA'
                                   AND e.fecha >= $P{FECHA_INICIO} AND e.fecha < $P{FECHA_FIN_EXCLUSIVA})))
         ORDER BY c.nombre, pr.no_proforma
    ]]></queryString>

    <field name="no_proforma" class="java.lang.String"/>
    <field name="negocio" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="direccion" class="java.lang.String"/>
    <field name="contacto" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="unidades" class="java.lang.Long"/>
    <field name="entrega" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <variable name="TOTAL_UNIDADES" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{unidades}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="478" height="24" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="18"/></textElement>
                <text><![CDATA[Nota de envío · carga a ruta]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="24" width="478" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{RUTA} + " · " + $P{FECHA}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="24" width="234" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Pedidos empacados por cargar y los que salieron a ruta ese día. No lleva firma de recibido.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <staticText><reportElement style="Header" x="0" y="0" width="24" height="26"/><textElement textAlignment="Center"/><text><![CDATA[#]]></text></staticText>
            <staticText><reportElement style="Header" x="24" y="0" width="76" height="26"/><box leftPadding="4"/><text><![CDATA[Pedido]]></text></staticText>
            <staticText><reportElement style="Header" x="100" y="0" width="176" height="26"/><box leftPadding="4"/><text><![CDATA[Cliente / negocio]]></text></staticText>
            <staticText><reportElement style="Header" x="276" y="0" width="196" height="26"/><box leftPadding="4"/><text><![CDATA[Dirección]]></text></staticText>
            <staticText><reportElement style="Header" x="472" y="0" width="106" height="26"/><box leftPadding="4"/><text><![CDATA[Encargado]]></text></staticText>
            <staticText><reportElement style="Header" x="578" y="0" width="68" height="26"/><box leftPadding="4"/><text><![CDATA[Teléfono]]></text></staticText>
            <staticText><reportElement style="Header" x="646" y="0" width="42" height="26"/><textElement textAlignment="Center"/><text><![CDATA[Unid.]]></text></staticText>
            <staticText><reportElement style="Header" x="688" y="0" width="64" height="26"/><textElement textAlignment="Center"/><text><![CDATA[Entrega est.]]></text></staticText>
            <staticText><reportElement style="Header" x="752" y="0" width="50" height="26"/><textElement textAlignment="Center"/><text><![CDATA[Estado]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26" splitType="Stretch">
            <textField><reportElement style="Cell" stretchType="RelativeToTallestObject" x="0" y="0" width="24" height="26"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="24" y="0" width="76" height="26"/><textElement><font isBold="true"/></textElement><textFieldExpression><![CDATA[$F{no_proforma}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="100" y="0" width="176" height="26"/><textFieldExpression><![CDATA[($F{negocio} != null && !$F{negocio}.trim().isEmpty()) ? $F{negocio} + " (" + $F{cliente} + ")" : $F{cliente}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="276" y="0" width="196" height="26"/><textFieldExpression><![CDATA[$F{direccion}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="472" y="0" width="106" height="26"/><textFieldExpression><![CDATA[$F{contacto}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="578" y="0" width="68" height="26"/><textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="646" y="0" width="42" height="26"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{unidades}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="688" y="0" width="64" height="26"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{entrega}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" stretchType="RelativeToTallestObject" x="752" y="0" width="50" height="26"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA["EN_RUTA".equals($F{estado}) ? "En ruta" : "Por cargar"]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="80">
            <line><reportElement x="0" y="8" width="802" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="420" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="6"/></textElement>
                <text><![CDATA[No hay pedidos empacados ni en ruta para esa ruta y fecha.]]></text>
            </staticText>
            <staticText><reportElement x="470" y="16" width="70" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pedidos:]]></text></staticText>
            <textField><reportElement x="540" y="16" width="40" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression></textField>
            <staticText><reportElement x="600" y="16" width="110" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Total de unidades:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="710" y="16" width="92" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="52" width="320" height="14" forecolor="#53647A"/><textElement><font size="9"/></textElement><text><![CDATA[Cargó: ______________________________]]></text></staticText>
            <staticText><reportElement x="360" y="52" width="320" height="14" forecolor="#53647A"/><textElement><font size="9"/></textElement><text><![CDATA[Piloto: ______________________________]]></text></staticText>
        </band>
    </summary>
</jasperReport>
