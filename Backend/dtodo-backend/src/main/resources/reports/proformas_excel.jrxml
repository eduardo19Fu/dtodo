<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="proformas_excel" pageWidth="1080" pageHeight="842" orientation="Landscape"
              columnWidth="1040" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <parameter name="FECHA_INI" class="java.util.Date"/>
    <parameter name="FECHA_FIN" class="java.util.Date"/>
    <parameter name="EXPORTAR_TODAS" class="java.lang.Boolean"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <queryString language="SQL"><![CDATA[
        SELECT p.no_proforma AS no_proforma,
               p.fecha_emision AS fecha_emision,
               c.nombre AS cliente,
               c.nit AS nit,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS vendedor,
               u.usuario AS usuario,
               p.total AS total,
               e.estado AS estado
          FROM proformas p
          INNER JOIN clientes c ON c.id_cliente = p.id_cliente
          INNER JOIN usuarios u ON u.id_usuario = p.id_usuario
          INNER JOIN estados e ON e.id_estado = p.id_estado
         WHERE ($P{EXPORTAR_TODAS} = TRUE OR
               (p.fecha_emision >= $P{FECHA_INI} AND p.fecha_emision < $P{FECHA_FIN}))
         ORDER BY p.fecha_emision DESC
    ]]></queryString>
    <field name="no_proforma" class="java.lang.String"/>
    <field name="fecha_emision" class="java.sql.Timestamp"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="nit" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="usuario" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="estado" class="java.lang.String"/>
    <title>
        <band height="58">
            <staticText>
                <reportElement x="0" y="0" width="1040" height="34" forecolor="#FFFFFF" backcolor="#343A40" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="18" isBold="true"/></textElement>
                <text><![CDATA[Listado de Proformas]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="1040" height="20" forecolor="#495057"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RANGO}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement x="0" y="0" width="130" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[No. Proforma]]></text></staticText>
            <staticText><reportElement x="130" y="0" width="130" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Fecha]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="220" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Cliente]]></text></staticText>
            <staticText><reportElement x="480" y="0" width="110" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[NIT]]></text></staticText>
            <staticText><reportElement x="590" y="0" width="150" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Vendedor]]></text></staticText>
            <staticText><reportElement x="740" y="0" width="100" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Usuario]]></text></staticText>
            <staticText><reportElement x="840" y="0" width="90" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
            <staticText><reportElement x="930" y="0" width="110" height="30" forecolor="#FFFFFF" backcolor="#6C757D" mode="Opaque"/><box><pen lineWidth="0.5" lineColor="#CED4DA"/></box><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[Estado]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="24">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="130" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{no_proforma}]]></textFieldExpression></textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true"><reportElement x="130" y="0" width="130" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha_emision}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="260" y="0" width="220" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="480" y="0" width="110" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{nit}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="590" y="0" width="150" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="740" y="0" width="100" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{usuario}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true"><reportElement x="840" y="0" width="90" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="930" y="0" width="110" height="24"/><box><pen lineWidth="0.5" lineColor="#DEE2E6"/></box><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
