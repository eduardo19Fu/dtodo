<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rpt_nota_credito" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d9a6b7a9-9321-4e6d-ab00-58914586fe34">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="AbarrotesAdapter.jrdax"/>
	<parameter name="idNotaCredito" class="java.lang.Long"/>
	<queryString language="SQL">
		<![CDATA[SELECT LPAD(nc.id_nota_credito, 7, '0') AS id_nota_credito,
			nc.correlativo_factura_sat,
			nc.serie_factura_sat,
			nc.fecha_creacion,
			nc.fecha_entrega_estimada,
			nc.total,
			nc.estado,
			cl.nombre AS cliente,
			cl.nit,
			cl.direccion,
			CONCAT(us.primer_nombre, ' ', us.apellido) AS vendedor,
			nc.observaciones,
			p.cod_producto AS codigo,
			p.nombre AS nombre_producto,
			ncd.cantidad,
			CASE WHEN ncd.sub_total > ncd.sub_total_descuento
			     THEN ncd.sub_total / NULLIF(ncd.cantidad, 0)
			     ELSE ncd.sub_total_descuento / NULLIF(ncd.cantidad, 0)
			          / NULLIF(1 - (COALESCE(ncd.descuento, 0) / 100), 0)
			END AS precio_venta,
			ncd.descuento,
			ncd.sub_total,
			ncd.sub_total_descuento
FROM notas_credito AS nc
INNER JOIN clientes AS cl ON nc.id_cliente = cl.id_cliente
INNER JOIN usuarios AS us ON us.id_usuario = nc.id_usuario
LEFT JOIN notas_credito_detalle AS ncd ON ncd.id_nota_credito = nc.id_nota_credito
LEFT JOIN productos AS p ON p.id_producto = ncd.id_producto
WHERE nc.id_nota_credito = $P{idNotaCredito}]]>
	</queryString>
