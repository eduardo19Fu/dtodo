					<printWhenExpression><![CDATA["TIENDA".equals($P{COPIA}) && $F{observaciones} != null && !$F{observaciones}.trim().isEmpty()]]></printWhenExpression>
				</reportElement>
				<textElement>
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA["Observaciones del pedido: " + $F{observaciones}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
</jasperReport>
