<?xml version="1.0" encoding="UTF-8"?>
<!-- Proforma mayorista: derivada de proforma.jrxml (formato JasperReports 6.x). Se edita a mano; no abrir ni guardar con
     Jaspersoft Studio 7, que cambia el formato y la librería del proyecto no lo entiende. Tiene dos copias, según
     el parámetro COPIA: CLIENTE (la que se entrega) y TIENDA (agrega la observación general del pedido). -->
<!-- Created with Jaspersoft Studio version 6.19.1.final using JasperReports Library version 6.19.1-867c00bf88cd4d784d404379d6c05e1b419e8a4c  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="proforma_mayorista" pageWidth="612" pageHeight="792" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7d1f0c5e-3b2a-4c8e-9a41-2f6b8e0d5a13">
	<property name="ireport.zoom" value="1.3310000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter1.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="proformaId" class="java.lang.Long"/>
	<parameter name="COPIA" class="java.lang.String">
		<defaultValueExpression><![CDATA["CLIENTE"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT cl.nombre,
        cl.nombre_negocio,
        cl.direccion,
        cl.nit,
        cl.contacto,
        cl.telefono_contacto,
        cl.dias_credito,
        ru.nombre AS ruta,
        date_format(pr.fecha_emision,'%d/%m/%Y'),
        pr.no_proforma,
        pr.total,
        pr.observaciones,
        CAST(IF(prd.descuento > 0, prd.nuevo_precio_venta, COALESCE(prd.precio_unitario, p.precio_venta)) AS DECIMAL(19,2)) as precio_venta,
        p.nombre AS producto,
        prd.cantidad,
        prd.descuento,
        prd.sub_total_descuento,
        prd.observacion,
        CONCAT(us.primer_nombre,' ', us.apellido) AS vendedor,
        get_numero_letras(pr.total) AS total_letras,
        COALESCE(s.direccion, '') AS sucursal_direccion,
        COALESCE(s.telefono, '') AS sucursal_telefono
FROM proformas AS pr
INNER JOIN clientes AS cl ON pr.id_cliente = cl.id_cliente
INNER JOIN proformas_detalle AS prd ON prd.id_proforma = pr.id_proforma
INNER JOIN productos AS p ON p.id_producto = prd.id_producto
INNER JOIN usuarios AS us ON us.id_usuario = pr.id_usuario
LEFT JOIN sucursales AS s ON s.id_sucursal = pr.id_sucursal
LEFT JOIN rutas AS ru ON ru.id_ruta = pr.id_ruta
WHERE pr.id_proforma =  $P{proformaId}
ORDER BY p.nombre ASC]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="nombre_negocio" class="java.lang.String"/>
	<field name="direccion" class="java.lang.String"/>
	<field name="nit" class="java.lang.String"/>
	<field name="contacto" class="java.lang.String"/>
	<field name="telefono_contacto" class="java.lang.String"/>
