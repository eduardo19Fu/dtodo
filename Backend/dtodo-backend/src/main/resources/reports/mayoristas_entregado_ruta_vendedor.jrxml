<?xml version="1.0" encoding="UTF-8"?>
<!-- Ventas entregadas por ruta y vendedor. Plantilla escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Mismo lenguaje visual que la proforma y la cobranza. Solo el PDF usa
     esta maqueta: el Excel se genera aparte como tabla (ReporteMayoristasServiceImpl) con la misma consulta. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="mayoristas_entregado_ruta_vendedor" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="a4d17c93-0b6e-4e52-9f38-2c5a8e1b7d04">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#1F2A44"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2B3990" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><bottomPen lineWidth="0.5" lineColor="#E1E7F3"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{ruta_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8FD"/>
        </conditionalStyle>
    </style>
    <style name="Etiqueta" style="Base" fontSize="7.5" isBold="true" forecolor="#6B7A90"/>

    <parameter name="ID_RUTA" class="java.lang.Integer"/>
    <parameter name="RUTA" class="java.lang.String"/>
    <parameter name="ID_VENDEDOR" class="java.lang.Integer"/>
    <parameter name="VENDEDOR" class="java.lang.String"/>
    <parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT COALESCE(r.nombre, 'Sin ruta') AS ruta,
               TRIM(CONCAT(COALESCE(u.primer_nombre, ''), ' ', COALESCE(u.apellido, ''))) AS vendedor,
               COUNT(DISTINCT p.id_proforma) AS pedidos,
               CAST(SUM(ed.cantidad) AS SIGNED) AS unidades,
               COALESCE(SUM(ed.cantidad * (l.sub_total_descuento / NULLIF(l.cantidad, 0))), 0) AS valor_entregado
          FROM proformas_entregas e
          INNER JOIN proformas_entregas_detalle ed ON ed.id_entrega = e.id_entrega
          INNER JOIN proformas_detalle l ON l.id_detalle = ed.id_detalle
          INNER JOIN proformas p ON p.id_proforma = e.id_proforma
          INNER JOIN usuarios u ON u.id_usuario = p.id_usuario
          LEFT JOIN rutas r ON r.id_ruta = p.id_ruta
         WHERE e.anulada = 0
           AND p.tipo_proforma = 'MAYORISTA'
           AND p.id_estado != 4
           AND e.fecha_entrega >= CAST($P{FECHA_INICIO} AS DATE)
           AND e.fecha_entrega < CAST($P{FECHA_FIN_EXCLUSIVA} AS DATE)
           AND ($P{ID_RUTA} IS NULL OR p.id_ruta = $P{ID_RUTA})
           AND ($P{ID_VENDEDOR} IS NULL OR p.id_usuario = $P{ID_VENDEDOR})
         GROUP BY r.id_ruta, r.nombre, u.id_usuario, u.primer_nombre, u.apellido
         ORDER BY r.nombre, vendedor
    ]]></queryString>

    <field name="ruta" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="pedidos" class="java.lang.Long"/>
    <field name="unidades" class="java.lang.Long"/>
    <field name="valor_entregado" class="java.math.BigDecimal"/>

    <variable name="TOTAL_PEDIDOS" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{pedidos}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{unidades}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valor_entregado}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="PEDIDOS_RUTA" class="java.lang.Long" resetType="Group" resetGroup="ruta" calculation="Sum">
        <variableExpression><![CDATA[$F{pedidos}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="UNIDADES_RUTA" class="java.lang.Long" resetType="Group" resetGroup="ruta" calculation="Sum">
        <variableExpression><![CDATA[$F{unidades}]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="VALOR_RUTA" class="java.math.BigDecimal" resetType="Group" resetGroup="ruta" calculation="Sum">
        <variableExpression><![CDATA[$F{valor_entregado}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <group name="ruta">
        <groupExpression><![CDATA[$F{ruta}]]></groupExpression>
        <groupHeader>
            <band height="30">
                <rectangle radius="6">
                    <reportElement mode="Opaque" x="0" y="6" width="802" height="22" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
                    <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
                </rectangle>
                <rectangle>
                    <reportElement mode="Opaque" x="0" y="6" width="5" height="22" forecolor="#2B3990" backcolor="#2B3990"/>
                    <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
                </rectangle>
                <textField isBlankWhenNull="true">
                    <reportElement x="14" y="6" width="780" height="22" forecolor="#2B3990"/>
                    <textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["Ruta: " + $F{ruta}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="34">
                <textField>
                    <reportElement mode="Opaque" x="0" y="2" width="342" height="22" backcolor="#E4E9F6" forecolor="#2B3990"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/><paragraph rightIndent="8"/></textElement>
                    <textFieldExpression><![CDATA["Subtotal de la ruta:"]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement mode="Opaque" x="342" y="2" width="120" height="22" backcolor="#E4E9F6" forecolor="#2B3990"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/><paragraph rightIndent="8"/></textElement>
                    <textFieldExpression><![CDATA[$V{PEDIDOS_RUTA}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement mode="Opaque" x="462" y="2" width="160" height="22" backcolor="#E4E9F6" forecolor="#2B3990"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/><paragraph rightIndent="8"/></textElement>
                    <textFieldExpression><![CDATA[$V{UNIDADES_RUTA}]]></textFieldExpression>
                </textField>
                <textField pattern="Q #,##0.00">
                    <reportElement mode="Opaque" x="622" y="2" width="180" height="22" backcolor="#E4E9F6" forecolor="#2B3990"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/><paragraph rightIndent="8"/></textElement>
                    <textFieldExpression><![CDATA[$V{VALOR_RUTA}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="182">
            <!-- Logo sin fondo y panel azul del reporte -->
            <image scaleImage="RetainShape" hAlign="Left">
                <reportElement x="0" y="2" width="130" height="68"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo-proforma.png")]]></imageExpression>
            </image>
            <rectangle radius="9">
                <reportElement mode="Opaque" x="236" y="2" width="566" height="66" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="252" y="8" width="260" height="11" forecolor="#C3CFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <text><![CDATA[VENTAS MAYORISTAS · ENTREGAS]]></text>
            </staticText>
            <staticText>
                <reportElement x="252" y="19" width="380" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="15" isBold="true"/></textElement>
                <text><![CDATA[Ventas entregadas por ruta y vendedor]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="252" y="46" width="380" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RUTA} == null ? "Todas las rutas" : $P{RUTA}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="640" y="10" width="150" height="10" forecolor="#C3CFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[PERÍODO]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="590" y="21" width="200" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RANGO}]]></textFieldExpression>
            </textField>

            <!-- Cómo se lee -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="80" width="802" height="34" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="80" width="5" height="34" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="84" width="776" height="26" forecolor="#6B7A90"/>
                <textElement verticalAlignment="Middle"><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Solo lo entregado al cliente, por la fecha de entrega y a su precio de línea con descuento. Una entrega parcial suma solo lo entregado y las entregas anuladas no cuentan.]]></text>
            </staticText>

            <!-- Resumen -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="126" width="193" height="46" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="14" y="132" width="170" height="11" forecolor="#C3CFFF"/><textElement><font size="7.5" isBold="true"/></textElement><text><![CDATA[Valor entregado]]></text></staticText>
            <textField evaluationTime="Report" pattern="Q #,##0.00"><reportElement x="14" y="144" width="172" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_VALOR}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="203" y="126" width="193" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="217" y="132" width="170" height="11"/><text><![CDATA[Pedidos con entregas]]></text></staticText>
            <textField evaluationTime="Report" pattern="#,##0"><reportElement x="217" y="144" width="172" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_PEDIDOS}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="406" y="126" width="193" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="420" y="132" width="170" height="11"/><text><![CDATA[Unidades entregadas]]></text></staticText>
            <textField evaluationTime="Report" pattern="#,##0"><reportElement x="420" y="144" width="172" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="609" y="126" width="193" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="623" y="132" width="170" height="11"/><text><![CDATA[Vendedor]]></text></staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement x="623" y="144" width="172" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{VENDEDOR} == null ? "Todos los vendedores" : $P{VENDEDOR}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement style="Header" x="0" y="2" width="342" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><text><![CDATA[Vendedor]]></text></staticText>
            <staticText><reportElement style="Header" x="342" y="2" width="120" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[Pedidos]]></text></staticText>
            <staticText><reportElement style="Header" x="462" y="2" width="160" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[Unidades entregadas]]></text></staticText>
            <staticText><reportElement style="Header" x="622" y="2" width="180" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[Valor entregado]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="26">
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="0" y="0" width="342" height="26"/><textElement textAlignment="Left"><font size="8.5" isBold="true"/><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement style="Cell" x="342" y="0" width="120" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{pedidos}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement style="Cell" x="462" y="0" width="160" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{unidades}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="Cell" x="622" y="0" width="180" height="26"/><textElement textAlignment="Right"><font size="9" isBold="true"/><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{valor_entregado}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="2" width="802" height="1" forecolor="#E1E7F3"/></line>
            <staticText>
                <reportElement x="0" y="5" width="300" height="14" forecolor="#7B8798"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Ventas entregadas · D'Todo]]></text>
            </staticText>
            <textField>
                <reportElement x="642" y="5" width="115" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="5" width="35" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="76">
            <!-- Fila de totales alineada con las columnas -->
            <staticText><reportElement style="Header" x="0" y="8" width="342" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="8"/></textElement><text><![CDATA[Total entregado:]]></text></staticText>
            <textField pattern="#,##0"><reportElement style="Header" x="342" y="8" width="120" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_PEDIDOS}]]></textFieldExpression></textField>
            <textField pattern="#,##0"><reportElement style="Header" x="462" y="8" width="160" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="Header" x="622" y="8" width="180" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_VALOR}]]></textFieldExpression></textField>
            <staticText>
                <reportElement x="0" y="46" width="460" height="26" forecolor="#52647C" backcolor="#F2F5FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} == null || $V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D3DBEE"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[No hay entregas de pedidos mayoristas en el período seleccionado.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
