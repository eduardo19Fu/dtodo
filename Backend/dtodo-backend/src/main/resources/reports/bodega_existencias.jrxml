<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bodega_existencias" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="0d7a9c52-6b1e-4e3a-8f47-93a1b2c4d5e6">
    <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.remove.empty.space.between.rows" value="true"/>
    <property name="net.sf.jasperreports.export.xlsx.white.page.background" value="false"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#23344D"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#1769D2" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box leftPadding="3" rightPadding="3"><pen lineWidth="0.35" lineColor="#D9E3EF"/></box>
    </style>
    <style name="ExistenciaCell" style="Cell">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{stock_minimo} != null && $F{stock_minimo}.intValue() > 0 && $F{existencia}.intValue() <= $F{stock_minimo}.intValue()]]></conditionExpression>
            <style forecolor="#B42318" isBold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="ID_BODEGA" class="java.lang.Integer"/>
    <parameter name="BODEGA" class="java.lang.String"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT p.cod_producto AS codigo,
               p.nombre AS producto,
               tp.tipo_producto AS categoria,
               inv.stock AS existencia,
               inv.stock_minimo AS stock_minimo,
               COALESCE(p.precio_compra, 0) AS costo_unitario,
               inv.stock * COALESCE(p.precio_compra, 0) AS valor_total
          FROM inventario_bodega inv
          INNER JOIN productos p ON p.id_producto = inv.id_producto
          INNER JOIN tipos_producto tp ON tp.id_tipo_producto = p.id_tipo_producto
         WHERE inv.id_bodega = $P{ID_BODEGA}
         ORDER BY p.nombre, p.cod_producto
    ]]></queryString>

    <field name="codigo" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="existencia" class="java.lang.Integer"/>
    <field name="stock_minimo" class="java.lang.Integer"/>
    <field name="costo_unitario" class="java.math.BigDecimal"/>
    <field name="valor_total" class="java.math.BigDecimal"/>

    <variable name="CANTIDAD_PRODUCTOS" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{codigo}]]></variableExpression>
    </variable>
    <variable name="TOTAL_UNIDADES" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[Long.valueOf($F{existencia}.longValue())]]></variableExpression>
        <initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
    </variable>
    <variable name="TOTAL_VALOR" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{valor_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="72">
            <rectangle radius="8">
                <reportElement x="90" y="0" width="712" height="48" forecolor="#1769D2" backcolor="#1769D2"/>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center">
                <reportElement x="0" y="0" width="72" height="48"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo.jpg")]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="90" y="0" width="478" height="24" forecolor="#FFFFFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/><paragraph leftIndent="18"/></textElement>
                <text><![CDATA[Existencias de bodega]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="24" width="478" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="18"/></textElement>
                <textFieldExpression><![CDATA[$P{BODEGA} + " · Inventario actual"]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="568" y="24" width="234" height="24" forecolor="#DCEBFF" backcolor="#1769D2" mode="Opaque"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/><paragraph rightIndent="18"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="54" width="802" height="14" forecolor="#66758A"/>
                <textElement><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Las existencias en rojo están en o por debajo del stock mínimo configurado. El valor se calcula al costo de compra actual.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText><reportElement style="Header" x="0" y="0" width="90" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Código]]></text></staticText>
            <staticText><reportElement style="Header" x="90" y="0" width="230" height="28"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="320" y="0" width="120" height="28"/><text><![CDATA[Categoría]]></text></staticText>
            <staticText><reportElement style="Header" x="440" y="0" width="70" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Existencia]]></text></staticText>
            <staticText><reportElement style="Header" x="510" y="0" width="70" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Stock mínimo]]></text></staticText>
            <staticText><reportElement style="Header" x="580" y="0" width="100" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Costo unitario]]></text></staticText>
            <staticText><reportElement style="Header" x="680" y="0" width="122" height="28"/><textElement textAlignment="Center"/><text><![CDATA[Valor total]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="0" y="0" width="90" height="24"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="90" y="0" width="230" height="24"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="Cell" x="320" y="0" width="120" height="24"/><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="ExistenciaCell" x="440" y="0" width="70" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{existencia}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement style="Cell" x="510" y="0" width="70" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{stock_minimo}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="580" y="0" width="100" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true"><reportElement style="Cell" x="680" y="0" width="122" height="24"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{valor_total}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement x="642" y="2" width="115" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="757" y="2" width="35" height="14" forecolor="#7B8798">
                    <printWhenExpression><![CDATA["PDF".equals($P{FORMATO})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="52">
            <line><reportElement x="0" y="8" width="802" height="1" forecolor="#B9C9DC"/></line>
            <staticText>
                <reportElement x="0" y="16" width="330" height="24" forecolor="#52647C" backcolor="#F4F8FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D6E2F0"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[La bodega no tiene productos en su inventario.]]></text>
            </staticText>
            <staticText><reportElement x="365" y="16" width="65" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Productos:]]></text></staticText>
            <textField><reportElement x="430" y="16" width="40" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{CANTIDAD_PRODUCTOS} == null ? 0 : $V{CANTIDAD_PRODUCTOS}]]></textFieldExpression></textField>
            <staticText><reportElement x="485" y="16" width="70" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unidades:]]></text></staticText>
            <textField pattern="#,##0"><reportElement x="555" y="16" width="60" height="20" forecolor="#17233B"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_UNIDADES} == null ? 0 : $V{TOTAL_UNIDADES}]]></textFieldExpression></textField>
            <staticText><reportElement x="625" y="16" width="80" height="20" forecolor="#53647A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Valor total:]]></text></staticText>
            <textField pattern="Q #,##0.00"><reportElement x="705" y="16" width="97" height="20" forecolor="#1769D2"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_VALOR} == null ? java.math.BigDecimal.ZERO : $V{TOTAL_VALOR}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
