<?xml version="1.0" encoding="UTF-8"?>
<!-- Resumen de ingresos de un vendedor (póliza individual). Plantilla escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Mismo lenguaje visual que la proforma y los demás reportes. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="poliza" pageWidth="612" pageHeight="792" columnWidth="572"
              whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="28">
    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#1F2A44"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2B3990" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><bottomPen lineWidth="0.5" lineColor="#E1E7F3"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8FD"/>
        </conditionalStyle>
    </style>
    <style name="Ganancia" style="Cell" isBold="true" forecolor="#087453">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{ganancia} != null && $F{ganancia}.signum() < 0]]></conditionExpression>
            <style forecolor="#B42318"/>
        </conditionalStyle>
    </style>
    <style name="Etiqueta" style="Base" fontSize="7.5" isBold="true" forecolor="#6B7A90"/>

    <parameter name="fechaInicio" class="java.util.Date">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="fechaFin" class="java.util.Date">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="sucursal" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="usuario" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[select
    sum(fd.cantidad) as cantidad,
    p.nombre as nombre_producto,
    p.precio_compra * sum(fd.cantidad) as pc_total,
    sum(fd.sub_total_descuento) as pv_total,
    sum(fd.sub_total_descuento) - (p.precio_compra * sum(fd.cantidad)) as ganancia,
    concat(u.primer_nombre,' ',u.apellido) as vendedor,
    s.nombre as sucursal
from facturas_detalle fd
inner join facturas f on f.id_factura = fd.id_factura
inner join productos p on p.id_producto = fd.id_producto
inner join usuarios u on u.id_usuario = f.id_usuario
inner join sucursales s on s.id_sucursal = f.id_sucursal
where f.id_estado != 4
    and date(f.fecha) between $P{fechaInicio} and $P{fechaFin}
    and f.id_sucursal = $P{sucursal}
    and f.id_usuario = $P{usuario}
group by p.id_producto, p.nombre, p.precio_compra, u.primer_nombre, u.apellido, s.nombre
order by p.nombre asc;]]>
    </queryString>

    <field name="cantidad" class="java.math.BigDecimal"/>
    <field name="nombre_producto" class="java.lang.String"/>
    <field name="pc_total" class="java.math.BigDecimal"/>
    <field name="pv_total" class="java.math.BigDecimal"/>
    <field name="ganancia" class="java.math.BigDecimal"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="sucursal" class="java.lang.String"/>

    <variable name="totalPc" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{pc_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="totalPv" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{pv_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="totalGanancia" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{ganancia}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="productos" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{nombre_producto}]]></variableExpression>
    </variable>

    <title>
        <band height="170">
            <image scaleImage="RetainShape" hAlign="Left">
                <reportElement x="0" y="2" width="110" height="58"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo-proforma.png")]]></imageExpression>
            </image>
            <rectangle radius="9">
                <reportElement mode="Opaque" x="122" y="2" width="450" height="60" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="136" y="8" width="250" height="11" forecolor="#C3CFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <text><![CDATA[VENTAS · PÓLIZA INDIVIDUAL]]></text>
            </staticText>
            <staticText>
                <reportElement x="136" y="19" width="280" height="24" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="15" isBold="true"/></textElement>
                <text><![CDATA[Resumen de ingresos]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="136" y="43" width="280" height="15" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[($F{vendedor} == null ? "" : $F{vendedor}) + ($F{sucursal} == null ? "" : " · " + $F{sucursal})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="424" y="10" width="136" height="10" forecolor="#C3CFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[PERÍODO]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="410" y="21" width="150" height="30" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaInicio}) + " al " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaFin})]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="424" y="49" width="136" height="10" forecolor="#C3CFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="70" width="572" height="30" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="70" width="5" height="30" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="14" y="73" width="550" height="24" forecolor="#6B7A90"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isItalic="true"/></textElement>
                <text><![CDATA[P.V. es lo facturado con descuento en el período; P.C. es el precio de compra actual por la cantidad vendida; la ganancia es la diferencia. No incluye facturas anuladas.]]></text>
            </staticText>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="108" width="134" height="46" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="12" y="114" width="114" height="11" forecolor="#C3CFFF"/><textElement><font size="7.5" isBold="true"/></textElement><text><![CDATA[Total facturado (P.V.)]]></text></staticText>
            <textField evaluationTime="Report" pattern="Q #,##0.00" textAdjust="ScaleFont"><reportElement x="12" y="126" width="114" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{totalPv}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="146" y="108" width="134" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="158" y="114" width="114" height="11"/><text><![CDATA[Costo (P.C.)]]></text></staticText>
            <textField evaluationTime="Report" pattern="Q #,##0.00" textAdjust="ScaleFont"><reportElement x="158" y="126" width="114" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{totalPc}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="292" y="108" width="134" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="304" y="114" width="114" height="11"/><text><![CDATA[Ganancia]]></text></staticText>
            <textField evaluationTime="Report" pattern="Q #,##0.00" textAdjust="ScaleFont"><reportElement x="304" y="126" width="114" height="22" forecolor="#087453"/><textElement verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{totalGanancia}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="438" y="108" width="134" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="450" y="114" width="114" height="11"/><text><![CDATA[Productos vendidos]]></text></staticText>
            <textField evaluationTime="Report" pattern="#,##0" textAdjust="ScaleFont"><reportElement x="450" y="126" width="114" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{productos} == null ? Integer.valueOf(0) : $V{productos}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement style="Header" x="0" y="2" width="62" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[Cantidad]]></text></staticText>
            <staticText><reportElement style="Header" x="62" y="2" width="230" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement style="Header" x="292" y="2" width="94" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[P.C. Total]]></text></staticText>
            <staticText><reportElement style="Header" x="386" y="2" width="94" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[P.V. Total]]></text></staticText>
            <staticText><reportElement style="Header" x="480" y="2" width="92" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><text><![CDATA[Ganancia]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="24">
            <textField pattern="#,##0" isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="0" y="0" width="62" height="24"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="62" y="0" width="230" height="24"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{nombre_producto}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="292" y="0" width="94" height="24"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{pc_total}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="386" y="0" width="94" height="24"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{pv_total}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00" isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Ganancia" x="480" y="0" width="92" height="24"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$F{ganancia}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="22">
            <line><reportElement x="0" y="2" width="572" height="1" forecolor="#E1E7F3"/></line>
            <staticText>
                <reportElement x="0" y="6" width="260" height="14" forecolor="#7B8798"/>
                <textElement><font size="8"/></textElement>
                <text><![CDATA[Resumen de ingresos · D'Todo]]></text>
            </staticText>
            <textField>
                <reportElement x="412" y="6" width="115" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="527" y="6" width="35" height="14" forecolor="#7B8798"/>
                <textElement textAlignment="Left"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[" de " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="80">
            <staticText><reportElement style="Header" x="0" y="8" width="292" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="8"/></textElement><text><![CDATA[Totales]]></text></staticText>
            <textField pattern="Q #,##0.00"><reportElement style="Header" x="292" y="8" width="94" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{totalPc}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="Header" x="386" y="8" width="94" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{totalPv}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="Header" x="480" y="8" width="92" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="8"/></textElement><textFieldExpression><![CDATA[$V{totalGanancia}]]></textFieldExpression></textField>
            <staticText>
                <reportElement x="0" y="46" width="420" height="26" forecolor="#52647C" backcolor="#F2F5FC" mode="Opaque">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} == null || $V{REPORT_COUNT}.intValue() == 0]]></printWhenExpression>
                </reportElement>
                <box><pen lineWidth="0.5" lineColor="#D3DBEE"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isItalic="true"/><paragraph leftIndent="8"/></textElement>
                <text><![CDATA[No hay ventas del vendedor en el período seleccionado.]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
