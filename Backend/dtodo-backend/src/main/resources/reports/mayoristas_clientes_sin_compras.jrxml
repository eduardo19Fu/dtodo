<?xml version="1.0" encoding="UTF-8"?>
<!-- Clientes mayoristas sin compras. Plantilla escrita a mano en formato JasperReports 6.x; no abrir ni guardar con Jaspersoft Studio 7,
     que cambia el formato y la librería del proyecto no lo entiende. Mismo lenguaje visual que la proforma y la cobranza. Solo el PDF usa
     esta maqueta: el Excel se genera aparte como tabla (ReporteMayoristasServiceImpl) con la misma consulta. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="mayoristas_clientes_sin_compras" pageWidth="842" pageHeight="595" orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="18" bottomMargin="18" isSummaryWithPageHeaderAndFooter="true"
              uuid="9d2a6f04-1c7b-4e83-b5a0-7f3e18c6d202">

    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="8" forecolor="#1F2A44"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2B3990" forecolor="#FFFFFF"
           fontSize="8" isBold="true" vTextAlign="Middle"/>
    <style name="Cell" style="Base" mode="Opaque" backcolor="#FFFFFF" vTextAlign="Middle">
        <box><bottomPen lineWidth="0.5" lineColor="#E1E7F3"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8FD"/>
        </conditionalStyle>
    </style>
    <style name="UltimaCompra" style="Cell">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{ultima_compra} == null]]></conditionExpression>
            <style forecolor="#B42318" isBold="true"/>
        </conditionalStyle>
    </style>
    <style name="Dias" style="Cell" isBold="true" forecolor="#8A5A00">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{dias_sin_compra} != null && $F{dias_sin_compra}.intValue() > 60]]></conditionExpression>
            <style forecolor="#B42318"/>
        </conditionalStyle>
    </style>
    <style name="Etiqueta" style="Base" fontSize="7.5" isBold="true" forecolor="#6B7A90"/>

    <parameter name="ID_RUTA" class="java.lang.Integer"/>
    <parameter name="RUTA" class="java.lang.String"/>
    <parameter name="FECHA_INICIO" class="java.sql.Timestamp"/>
    <parameter name="FECHA_FIN_EXCLUSIVA" class="java.sql.Timestamp"/>
    <parameter name="RANGO" class="java.lang.String"/>
    <parameter name="FORMATO" class="java.lang.String"/>

    <queryString language="SQL"><![CDATA[
        SELECT COALESCE(r.nombre, 'Sin ruta') AS ruta,
               TRIM(CONCAT(COALESCE(v.primer_nombre, ''), ' ', COALESCE(v.apellido, ''))) AS vendedor,
               c.codigo_cliente AS codigo,
               c.nombre_negocio AS negocio,
               c.nombre AS cliente,
               c.contacto AS contacto,
               c.telefono_contacto AS telefono,
               ult.ultima_compra AS ultima_compra,
               DATEDIFF(CURRENT_DATE, ult.ultima_compra) AS dias_sin_compra
          FROM clientes c
          LEFT JOIN rutas r ON r.id_ruta = c.id_ruta
          LEFT JOIN usuarios v ON v.id_usuario = r.id_vendedor
          LEFT JOIN (SELECT x.id_cliente, MAX(x.fecha) AS ultima_compra
                       FROM (SELECT p.id_cliente, p.fecha_emision AS fecha
                               FROM proformas p WHERE p.id_estado != 4
                              UNION ALL
                             SELECT f.id_cliente, f.fecha
                               FROM facturas f WHERE f.id_estado != 4) x
                      GROUP BY x.id_cliente) ult ON ult.id_cliente = c.id_cliente
         WHERE c.tipo_cliente = 'MAYORISTA'
           AND ($P{ID_RUTA} IS NULL OR c.id_ruta = $P{ID_RUTA})
           AND NOT EXISTS (SELECT 1 FROM proformas p
                            WHERE p.id_cliente = c.id_cliente AND p.id_estado != 4
                              AND p.fecha_emision >= $P{FECHA_INICIO} AND p.fecha_emision < $P{FECHA_FIN_EXCLUSIVA})
           AND NOT EXISTS (SELECT 1 FROM facturas f
                            WHERE f.id_cliente = c.id_cliente AND f.id_estado != 4
                              AND f.fecha >= $P{FECHA_INICIO} AND f.fecha < $P{FECHA_FIN_EXCLUSIVA})
         ORDER BY r.nombre, ult.ultima_compra IS NOT NULL, ult.ultima_compra, c.nombre
    ]]></queryString>

    <field name="ruta" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="negocio" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="contacto" class="java.lang.String"/>
    <field name="telefono" class="java.lang.String"/>
    <field name="ultima_compra" class="java.sql.Timestamp"/>
    <field name="dias_sin_compra" class="java.lang.Integer"/>

    <variable name="TOTAL_CLIENTES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{cliente}]]></variableExpression>
    </variable>
    <variable name="NUNCA_COMPRARON" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{ultima_compra} == null ? Integer.valueOf(1) : Integer.valueOf(0)]]></variableExpression>
        <initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
    </variable>

    <title>
        <band height="182">
            <image scaleImage="RetainShape" hAlign="Left">
                <reportElement x="0" y="2" width="130" height="68"/>
                <imageExpression><![CDATA[this.getClass().getResourceAsStream("/static/images/reports-image/logo-dtodo-proforma.png")]]></imageExpression>
            </image>
            <rectangle radius="9">
                <reportElement mode="Opaque" x="236" y="2" width="566" height="66" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="252" y="8" width="260" height="11" forecolor="#C3CFFF"/>
                <textElement verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                <text><![CDATA[VENTAS MAYORISTAS · SEGUIMIENTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="252" y="19" width="380" height="26" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Clientes sin compras]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="252" y="46" width="340" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Sin compras · " + $P{RANGO} + " · " + ($P{RUTA} == null ? "todas las rutas" : $P{RUTA})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="640" y="10" width="150" height="10" forecolor="#C3CFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <text><![CDATA[PERÍODO]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                <reportElement x="590" y="21" width="200" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="10.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{RANGO}]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="80" width="802" height="34" forecolor="#D3DBEE" backcolor="#F2F5FC"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <rectangle>
                <reportElement mode="Opaque" x="0" y="80" width="5" height="34" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="16" y="84" width="776" height="26" forecolor="#6B7A90"/>
                <textElement verticalAlignment="Middle"><font size="8" isItalic="true"/></textElement>
                <text><![CDATA[Se considera compra una proforma o una factura no anulada del cliente. "Nunca" significa que el cliente no tiene ninguna. Lo más urgente aparece primero.]]></text>
            </staticText>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="0" y="126" width="193" height="46" forecolor="#2B3990" backcolor="#2B3990"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#2B3990"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="14" y="132" width="170" height="11" forecolor="#C3CFFF"/><textElement><font size="7.5" isBold="true"/></textElement><text><![CDATA[Clientes sin compras]]></text></staticText>
            <textField evaluationTime="Report" pattern="#,##0"><reportElement x="14" y="144" width="172" height="22" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_CLIENTES} == null ? Integer.valueOf(0) : $V{TOTAL_CLIENTES}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="203" y="126" width="193" height="46" forecolor="#F1B5B0" backcolor="#FDECEB"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#F1B5B0"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="217" y="132" width="170" height="11" forecolor="#B42318"/><text><![CDATA[Nunca han comprado]]></text></staticText>
            <textField evaluationTime="Report" pattern="#,##0"><reportElement x="217" y="144" width="172" height="22" forecolor="#B42318"/><textElement verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{NUNCA_COMPRARON} == null ? Integer.valueOf(0) : $V{NUNCA_COMPRARON}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="406" y="126" width="193" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="420" y="132" width="170" height="11"/><text><![CDATA[Período revisado]]></text></staticText>
            <textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="420" y="144" width="172" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{RANGO}]]></textFieldExpression></textField>
            <rectangle radius="8">
                <reportElement mode="Opaque" x="609" y="126" width="193" height="46" forecolor="#D3DBEE" backcolor="#FFFFFF"/>
                <graphicElement><pen lineWidth="0.75" lineColor="#D3DBEE"/></graphicElement>
            </rectangle>
            <staticText><reportElement style="Etiqueta" x="623" y="132" width="170" height="11"/><text><![CDATA[Ruta del filtro]]></text></staticText>
            <textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="623" y="144" width="172" height="22" forecolor="#2B3990"/><textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{RUTA} == null ? "Todas las rutas" : $P{RUTA}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement style="Header" x="0" y="2" width="80" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><text><![CDATA[Ruta]]></text></staticText>
            <staticText><reportElement style="Header" x="80" y="2" width="100" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><text><![CDATA[Vendedor]]></text></staticText>
