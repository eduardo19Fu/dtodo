            <textField pattern="#,##0"><reportElement style="Header" x="352" y="8" width="100" height="26"/><textElement textAlignment="Left"><font size="9"/><paragraph leftIndent="4"/></textElement><textFieldExpression><![CDATA[$V{TOTAL_CLIENTES} == null ? 0 : $V{TOTAL_CLIENTES}]]></textFieldExpression></textField>
            <staticText><reportElement style="Header" x="452" y="8" width="230" height="26"/><textElement textAlignment="Right"><font size="9"/><paragraph rightIndent="8"/></textElement><text><![CDATA[Nunca han comprado:]]></text></staticText>
            <textField pattern="#,##0"><reportElement style="Header" x="682" y="8" width="120" height="26"/><textElement textAlignment="Left"><font size="9"/><paragraph leftIndent="4"/></textElement><textFieldExpression><![CDATA[$V{NUNCA_COMPRARON} == null ? 0 : $V{NUNCA_COMPRARON}]]></textFieldExpression></textField>
