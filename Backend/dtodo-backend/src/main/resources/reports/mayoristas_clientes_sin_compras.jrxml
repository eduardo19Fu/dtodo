            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="238" y="0" width="128" height="26"/><textElement textAlignment="Left"><font size="8.5" isBold="true"/><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{negocio}]]></textFieldExpression></textField>
