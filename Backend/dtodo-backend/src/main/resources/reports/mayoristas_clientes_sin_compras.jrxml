            <textField pattern="#,##0" isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Dias" x="736" y="0" width="66" height="26"/><textElement textAlignment="Right"><paragraph rightIndent="6"/></textElement><textFieldExpression><![CDATA[$F{dias_sin_compra}]]></textFieldExpression></textField>
