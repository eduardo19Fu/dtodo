            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="0" y="0" width="80" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{ruta}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" textAdjust="ScaleFont"><reportElement style="Cell" x="80" y="0" width="100" height="26"/><textElement textAlignment="Left"><paragraph leftIndent="8"/></textElement><textFieldExpression><![CDATA[$F{vendedor}]]></textFieldExpression></textField>
